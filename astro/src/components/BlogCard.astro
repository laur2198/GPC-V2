---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  href: string;
  heroImage?: string;
}
const { title, description, publishDate, category, href, heroImage } = Astro.props;
const formatted = publishDate.toISOString().slice(0, 10);
---

<a href={href} class="group block overflow-hidden border border-gpc-border bg-gpc-card/40 transition-colors hover:border-gpc-green">
  {heroImage && (
    <div class="aspect-video overflow-hidden bg-gpc-white">
      <img src={heroImage} alt={title} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform group-hover:scale-105" />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center justify-between font-mono text-xs">
      <span class="uppercase tracking-wider text-gpc-green">{category}</span>
      <time class="text-gpc-ink/50">{formatted}</time>
    </div>
    <h3 class="mt-2 font-display text-xl text-gpc-ink">{title}</h3>
    <p class="mt-2 font-mono text-sm text-gpc-ink/70">{description}</p>
  </div>
</a>
