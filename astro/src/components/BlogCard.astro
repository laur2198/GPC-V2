---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  href: string;
  heroImage?: string;
}
const { title, description, publishDate, category, href, heroImage } = Astro.props;
const formatted = publishDate.toISOString().slice(0, 10);
---

<a href={href} class="group block overflow-hidden border border-phoenix-gray bg-phoenix-gray/40 transition-colors hover:border-phoenix-green">
  {heroImage && (
    <div class="aspect-video overflow-hidden bg-phoenix-black">
      <img src={heroImage} alt={title} class="h-full w-full object-cover transition-transform group-hover:scale-105" />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center justify-between font-mono text-xs">
      <span class="uppercase tracking-wider text-phoenix-cyan">{category}</span>
      <time class="text-phoenix-light/50">{formatted}</time>
    </div>
    <h3 class="mt-2 font-display text-xl text-phoenix-light">{title}</h3>
    <p class="mt-2 font-mono text-sm text-phoenix-light/70">{description}</p>
  </div>
</a>
