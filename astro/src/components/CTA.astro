---
/**
 * CTA
 *
 * Props:
 *   heading    — main h2 (required)
 *   subtext    — supporting paragraph (optional)
 *   buttonText — CTA label (required)
 *   buttonLink — CTA href (required)
 *
 * Large centered call-to-action with a subtle "data flow" background
 * (animated diagonal stripes + glow accents).
 */
interface Props {
  heading?: string;
  subtext?: string;
  buttonText?: string;
  buttonLink?: string;
  /** legacy aliases — accepted but `heading`/`buttonText`/`buttonLink` are preferred */
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading,
  subtext,
  buttonText,
  buttonLink,
  title,
  description,
  ctaLabel,
  ctaHref,
} = Astro.props;
const finalHeading = heading ?? title ?? '';
const finalSub = subtext ?? description;
const finalLabel = buttonText ?? ctaLabel ?? '';
const finalLink = buttonLink ?? ctaHref ?? '#';
---

<section class="reveal relative overflow-hidden border-y border-gpc-border bg-gpc-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background-image: repeating-linear-gradient(45deg, rgba(5,5,5,0.04) 0 2px, transparent 2px 24px), repeating-linear-gradient(-45deg, rgba(67,160,71,0.04) 0 2px, transparent 2px 24px); animation: marquee 18s linear infinite;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-20 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full bg-gpc-green/20 blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-20 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full bg-gpc-green/15 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-4xl px-6 py-24 text-center">
    <h2 class="font-display text-4xl leading-tight md:text-5xl">
      <span class="glow-green">{finalHeading}</span>
    </h2>
    {finalSub && (
      <p class="mx-auto mt-6 max-w-2xl font-mono text-base leading-relaxed text-gpc-ink/80 md:text-lg">
        {finalSub}
      </p>
    )}
    <a
      href={finalLink}
      class="magnetic group mt-10 inline-flex items-center gap-3 border border-gpc-green bg-gpc-green/10 px-8 py-4 font-mono text-sm uppercase tracking-[0.25em] text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm"
    >
      {finalLabel}
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
