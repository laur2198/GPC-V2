---
/**
 * CaseStudyCard
 *
 * Props:
 *   title    — string
 *   industry — short tag, e.g. "E-COMMERCE"
 *   image    — hero image URL (optional)
 *   summary  — short paragraph
 *   link     — href to the case study detail page
 *   kpis     — exactly 3 objects [{ label, value }]
 *
 * Hover: scale 1.02 + neon green glow. Layout: image top, industry
 * tag mono, bold title, summary, KPI strip pinned at the bottom.
 */
interface Kpi {
  label: string;
  value: string;
}
interface Props {
  title: string;
  industry: string;
  image?: string;
  summary: string;
  link: string;
  kpis: [Kpi, Kpi, Kpi];
}
const { title, industry, image, summary, link, kpis } = Astro.props;
---

<a
  href={link}
  class="reveal group flex h-full flex-col overflow-hidden border border-gpc-border bg-gpc-card/30 transition-all duration-300 ease-[cubic-bezier(0.165,0.84,0.44,1)] hover:scale-[1.02] hover:border-gpc-green hover:shadow-sm"
>
  <div class="relative aspect-video overflow-hidden bg-gpc-white">
    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover opacity-90 grayscale-[20%] transition-all duration-500 ease-[cubic-bezier(0.165,0.84,0.44,1)] group-hover:scale-105 group-hover:opacity-100 group-hover:grayscale-0"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_30%_30%,rgba(67,160,71,0.12),transparent_60%)]">
        <span class="font-display text-4xl text-gpc-ink/20">{industry.slice(0, 2)}</span>
      </div>
    )}
    <span class="absolute left-4 top-4 border border-gpc-green/60 bg-gpc-white/70 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">
      {industry}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-2xl font-bold text-gpc-ink transition-colors group-hover:text-gpc-green">
      {title}
    </h3>
    <p class="mt-3 font-mono text-sm leading-relaxed text-gpc-ink/70">
      {summary}
    </p>

    <div class="mt-auto grid grid-cols-3 gap-2 border-t border-gpc-border pt-4 transition-colors group-hover:border-gpc-green/40">
      {kpis.map((k) => (
        <div class="text-center">
          <div class="font-display text-xl text-gpc-green">{k.value}</div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-gpc-ink/60">
            {k.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</a>
