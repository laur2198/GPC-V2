---
/**
 * FAQ
 *
 * Props:
 *   items — required array of { question, answer }
 *   title — optional section header (default "ÎNTREBĂRI FRECVENTE")
 *   schema — when true (default), emits a FAQPage JSON-LD block. Set
 *            false if BaseLayout already emits the schema for this page
 *            (avoid duplicate JSON-LD).
 *
 * Renders a smooth-expanding accordion. The "+" rotates 45° to "×"
 * when an item opens.
 */
interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  items: FaqItem[];
  title?: string;
  schema?: boolean;
}
const { items, title = 'ÎNTREBĂRI FRECVENTE', schema = true } = Astro.props;

const faqJsonLd = schema && items.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

<section class="border-y border-phoenix-gray bg-phoenix-black">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">
      {title}
    </p>

    <div class="mt-8 divide-y divide-phoenix-gray border border-phoenix-gray bg-phoenix-gray/20">
      {items.map((item) => (
        <details class="group transition-colors open:bg-phoenix-gray/40">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 transition-colors hover:text-phoenix-green"
          >
            <span class="font-display text-lg text-phoenix-light group-open:text-phoenix-green">
              {item.question}
            </span>
            <span
              class="grid h-8 w-8 flex-none place-items-center border border-phoenix-green/60 font-mono text-phoenix-green transition-transform duration-300 group-open:rotate-45 group-open:shadow-[0_0_14px_rgba(0,255,148,0.4)]"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-open:grid-rows-[1fr]"
          >
            <div class="overflow-hidden">
              <p class="px-6 pb-6 font-mono text-sm leading-relaxed text-phoenix-light/75">
                {item.answer}
              </p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>

  {faqJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}
</section>
