---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items: FAQItem[];
  title?: string;
}
const { items, title } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 py-16">
  {title && <h2 class="mb-10 font-display text-3xl glow-green">{title}</h2>}
  <div class="space-y-4">
    {items.map((item) => (
      <details class="group border border-phoenix-gray bg-phoenix-gray/40 p-5 open:border-phoenix-green">
        <summary class="cursor-pointer list-none font-mono text-sm text-phoenix-light">
          <span class="mr-2 text-phoenix-green">›</span>{item.q}
        </summary>
        <p class="mt-3 font-mono text-sm text-phoenix-light/70">{item.a}</p>
      </details>
    ))}
  </div>
</section>
