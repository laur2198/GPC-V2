---
/**
 * Footer
 *
 * Props:
 *   locale — 'ro' | 'en' | 'it' (default 'ro')
 *
 * Brand mark "GREEN PHEONIX®", quick links from i18n, ANPC SAL/SOL
 * badges, social icons (Facebook/Instagram/TikTok), tagline, current
 * year copyright with the legal SRL + CUI line.
 */
import { type Locale, t, localizedPath } from '../utils/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ro' } = Astro.props;

interface NavStrings {
  home: string;
  ads: string;
  web: string;
  portfolio: string;
  blog: string;
  about: string;
  contact: string;
}
const nav = t<NavStrings>(locale, 'nav');

interface FooterStrings {
  tagline: string;
  quickLinksHeader: string;
  legalHeader: string;
  contactHeader: string;
  rights: string;
  policy: string;
  terms: string;
  anpc: string;
  disclaimer: string;
}
const f = t<FooterStrings>(locale, 'footer');

const quickLinks = [
  { href: localizedPath(locale, '/'), label: nav.home },
  { href: localizedPath(locale, '/servicii-ads'), label: nav.ads },
  { href: localizedPath(locale, '/servicii-web'), label: nav.web },
  { href: localizedPath(locale, '/portofoliu'), label: nav.portfolio },
  { href: localizedPath(locale, '/blog'), label: nav.blog },
  { href: localizedPath(locale, '/despre'), label: nav.about },
  { href: localizedPath(locale, '/contact'), label: nav.contact },
];

const year = new Date().getFullYear();
---

<footer class="relative border-t border-phoenix-gray bg-phoenix-black">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-phoenix-green/60 to-transparent"
  ></div>

  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <a href={localizedPath(locale, '/')} class="flex items-center gap-2">
        <svg viewBox="0 0 32 32" class="h-7 w-7 text-phoenix-green" aria-hidden="true">
          <path
            fill="currentColor"
            d="M16 2 4 9v14l12 7 12-7V9L16 2Zm0 3.3 9.2 5.3v10.8L16 26.7 6.8 21.4V10.6L16 5.3Zm0 4.2-5.5 3.2v6.4l5.5 3.2 5.5-3.2v-6.4L16 9.5Z"
          />
        </svg>
        <span class="font-display text-base tracking-[0.18em] text-phoenix-light">
          GREEN <span class="glow-green">PHEONIX</span><span class="text-phoenix-light/60">®</span>
        </span>
      </a>
      <p class="mt-4 max-w-xs font-mono text-sm leading-relaxed text-phoenix-light/70">
        {f.tagline}
      </p>

      <ul class="mt-6 flex items-center gap-3">
        <li>
          <a
            href="https://www.facebook.com/profile.php?id=100079698837895"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="grid h-9 w-9 place-items-center border border-phoenix-gray text-phoenix-light/70 transition-colors hover:border-phoenix-green hover:text-phoenix-green"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.07 5.66 21.21 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.5-3.9 3.77-3.9 1.1 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.77-1.63 1.56v1.86h2.78l-.45 2.9h-2.33V22C18.34 21.2 22 17.07 22 12.06Z"/>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/green_pheonix_/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="grid h-9 w-9 place-items-center border border-phoenix-gray text-phoenix-light/70 transition-colors hover:border-phoenix-green hover:text-phoenix-green"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.5.01-4.74.07-1.07.05-1.65.23-2.04.38-.51.2-.88.44-1.27.83-.39.39-.63.76-.83 1.27-.15.39-.33.97-.38 2.04-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.07.23 1.65.38 2.04.2.51.44.88.83 1.27.39.39.76.63 1.27.83.39.15.97.33 2.04.38 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.07-.05 1.65-.23 2.04-.38.51-.2.88-.44 1.27-.83.39-.39.63-.76.83-1.27.15-.39.33-.97.38-2.04.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.07-.23-1.65-.38-2.04a2.4 2.4 0 0 0-.83-1.27 2.4 2.4 0 0 0-1.27-.83c-.39-.15-.97-.33-2.04-.38-1.24-.06-1.59-.07-4.74-.07Zm0 2.76a5.46 5.46 0 1 1 0 10.92 5.46 5.46 0 0 1 0-10.92Zm0 1.62a3.84 3.84 0 1 0 0 7.68 3.84 3.84 0 0 0 0-7.68Zm5.66-2.85a1.28 1.28 0 1 1 0 2.56 1.28 1.28 0 0 1 0-2.56Z"/>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.tiktok.com/@green.pheonix.concept"
            target="_blank"
            rel="noopener"
            aria-label="TikTok"
            class="grid h-9 w-9 place-items-center border border-phoenix-gray text-phoenix-light/70 transition-colors hover:border-phoenix-green hover:text-phoenix-green"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M16.6 2c.3 1.7 1.3 3.1 2.7 4 .9.6 2 .9 3.1.9v3.4c-1.3 0-2.5-.3-3.6-.9v6.7c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8c.4 0 .8 0 1.2.1v3.6a4.4 4.4 0 1 0 3.2 4.3V2h1.4Z"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">
        {f.quickLinksHeader}
      </h3>
      <ul class="mt-4 space-y-2">
        {quickLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="font-mono text-sm text-phoenix-light/80 transition-colors hover:text-phoenix-green"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">
        {f.legalHeader}
      </h3>
      <ul class="mt-4 space-y-2">
        <li>
          <a
            href={localizedPath(locale, '/politica')}
            class="font-mono text-sm text-phoenix-light/80 hover:text-phoenix-green"
          >
            {f.policy}
          </a>
        </li>
        <li>
          <a
            href={localizedPath(locale, '/politica')}
            class="font-mono text-sm text-phoenix-light/80 hover:text-phoenix-green"
          >
            {f.terms}
          </a>
        </li>
        <li>
          <a
            href="https://anpc.ro"
            target="_blank"
            rel="noopener"
            class="font-mono text-sm text-phoenix-light/80 hover:text-phoenix-green"
          >
            {f.anpc}
          </a>
        </li>
      </ul>

      <div class="mt-6 flex items-center gap-3">
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener" aria-label="ANPC SAL">
          <img
            src="/anpc-sal.png"
            alt="ANPC SAL"
            loading="lazy"
            class="h-12 w-auto opacity-80 transition-opacity hover:opacity-100"
          />
        </a>
        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener" aria-label="ANPC SOL">
          <img
            src="/anpc-sol.png"
            alt="ANPC SOL"
            loading="lazy"
            class="h-12 w-auto opacity-80 transition-opacity hover:opacity-100"
          />
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">
        {f.contactHeader}
      </h3>
      <ul class="mt-4 space-y-2 font-mono text-sm text-phoenix-light/80">
        <li>
          <a href="tel:+40793650902" class="hover:text-phoenix-green">+40 793 650 902</a>
        </li>
        <li>Brașov, România</li>
        <li>Mon–Fri 09:00–18:00</li>
        <li class="pt-2">
          <a
            href="https://wa.me/40793650902"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-phoenix-green hover:underline"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-phoenix-green shadow-[0_0_8px_#00FF94]"></span>
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-phoenix-gray">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-6 py-6 text-center font-mono text-[11px] uppercase tracking-widest text-phoenix-light/60 md:flex-row md:items-center md:justify-between md:text-left">
      <p>© {year} GREEN PHEONIX CONCEPT®. {f.rights}</p>
      <p>{f.disclaimer}</p>
    </div>
  </div>
</footer>
