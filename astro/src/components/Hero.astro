---
/**
 * Hero
 *
 * Props:
 *   locale       — 'ro' | 'en' | 'it' (required for full hero)
 *   ctaPrimary   — { label, href } override; defaults to i18n + /contact
 *   ctaSecondary — { label, href } override; defaults to i18n + /servicii-ads
 *   variant      — 'full' (default) | 'compact'
 *   title        — overrides h1 (any variant)
 *   subtitle     — overrides paragraph (any variant)
 *
 * 'full' renders eyebrow tags, h1, subtitle, dual CTAs, capability rail
 * and a marquee. 'compact' renders just title + subtitle — used by
 * inner pages.
 *
 * No fabricated performance numbers are rendered here. Real client
 * results live inside individual case studies once validated.
 */
import { type Locale, t, localizedPath } from '../utils/i18n';

interface CTA {
  label: string;
  href: string;
}
interface Props {
  locale?: Locale;
  ctaPrimary?: CTA;
  ctaSecondary?: CTA;
  variant?: 'full' | 'compact';
  title?: string;
  subtitle?: string;
  /** legacy: rendered only when variant='compact' */
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  locale = 'ro' as Locale,
  ctaPrimary,
  ctaSecondary,
  variant: variantProp,
  title,
  subtitle,
  ctaLabel,
  ctaHref,
} = Astro.props;
const variant = variantProp ?? (title ? 'compact' : 'full');

interface HeroStrings {
  eyebrow: { system: string; loc: string; version: string };
  h1: string;
  sub: string;
  ctaPrimary: string;
  ctaSecondary: string;
}
const hero = t<HeroStrings>(locale, 'hero');
const marquee = t<string[]>(locale, 'marquee');

const cta1 = ctaPrimary ?? { label: hero.ctaPrimary, href: localizedPath(locale, '/contact') };
const cta2 = ctaSecondary ?? { label: hero.ctaSecondary, href: localizedPath(locale, '/servicii-ads') };

const marqueeRow = [...marquee, ...marquee];
const headline = title ?? hero.h1;
const blurb = subtitle ?? hero.sub;

const capabilities = ['META', 'GOOGLE', 'TIKTOK', 'WEB'];
---

{variant === 'compact' && (
  <section class="relative overflow-hidden border-b border-gpc-border bg-gpc-white py-20">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: linear-gradient(rgba(5,5,5,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(5,5,5,0.04) 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <h1 class="font-display text-4xl leading-tight text-gpc-ink md:text-6xl">
        {headline}
      </h1>
      {blurb && (
        <p class="mt-6 font-sans text-base text-gpc-text-secondary md:text-lg">{blurb}</p>
      )}
      {ctaLabel && ctaHref && (
        <a
          href={ctaHref}
          class="mt-10 inline-block bg-gpc-red px-8 py-4 font-display text-sm uppercase tracking-widest text-white transition-colors hover:bg-gpc-red-dark"
        >
          {ctaLabel}
        </a>
      )}
    </div>
  </section>
)}

{variant === 'full' && (
<section class="relative overflow-hidden border-b border-gpc-border bg-gpc-white">
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background-image: linear-gradient(rgba(5,5,5,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(5,5,5,0.04) 1px, transparent 1px); background-size: 48px 48px;"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-5xl px-6 py-24 lg:py-32">
    <div class="flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-[0.2em]">
      <span class="border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 text-gpc-green">
        ◉ {hero.eyebrow.system}
      </span>
      <span class="border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 text-gpc-green">
        {hero.eyebrow.loc}
      </span>
      <span class="border border-gpc-border bg-gpc-card/40 px-2 py-1 text-gpc-ink/70">
        {hero.eyebrow.version}
      </span>
    </div>

    <h1 class="mt-10 max-w-4xl font-display text-5xl leading-[1.02] text-gpc-ink md:text-7xl lg:text-[5.5rem]">
      {hero.h1.split(' ').map((word, i, arr) => (
        <>
          {i === arr.length - 2 || i === arr.length - 1 ? (
            <span class="text-gpc-green">{word}{i < arr.length - 1 ? ' ' : ''}</span>
          ) : (
            <span>{word}{i < arr.length - 1 ? ' ' : ''}</span>
          )}
        </>
      ))}
    </h1>

    <p class="mt-8 max-w-2xl font-sans text-base leading-relaxed text-gpc-text-secondary md:text-lg">
      {hero.sub}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={cta1.href}
        class="group inline-flex items-center gap-2 bg-gpc-red px-8 py-4 font-display text-sm uppercase tracking-widest text-white transition-colors hover:bg-gpc-red-dark"
      >
        {cta1.label}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a
        href={cta2.href}
        class="inline-flex items-center gap-2 border border-gpc-ink px-8 py-4 font-display text-sm uppercase tracking-widest text-gpc-ink transition-colors hover:bg-gpc-ink hover:text-white"
      >
        {cta2.label}
      </a>
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-gpc-border pt-6 font-mono text-[11px] uppercase tracking-[0.3em] text-gpc-text-muted">
      <span>///</span>
      {capabilities.map((c) => (
        <span class="text-gpc-ink">{c}</span>
      ))}
    </div>
  </div>

  <div class="relative overflow-hidden border-y border-gpc-border bg-gpc-card py-3">
    <div class="marquee-track">
      {marqueeRow.map((item) => (
        <span class="mx-6 inline-flex items-center gap-6 font-mono text-xs uppercase tracking-[0.3em] text-gpc-text-secondary">
          <span class="text-gpc-green">///</span>
          {item}
        </span>
      ))}
    </div>
  </div>
</section>
)}
