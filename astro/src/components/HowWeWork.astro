---
interface Step {
  title: string;
  description: string;
}
interface Props {
  title?: string;
  steps: Step[];
}
const { title, steps } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-16">
  {title && <h2 class="mb-10 font-display text-3xl glow-green">{title}</h2>}
  <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {steps.map((step, i) => (
      <li class="border border-phoenix-gray bg-phoenix-gray/40 p-6">
        <div class="font-display text-4xl glow-cyan">{String(i + 1).padStart(2, '0')}</div>
        <h3 class="mt-4 font-display text-lg text-phoenix-light">{step.title}</h3>
        <p class="mt-2 font-mono text-sm text-phoenix-light/70">{step.description}</p>
      </li>
    ))}
  </ol>
</section>
