---
/**
 * HowWeWork
 *
 * Props:
 *   locale  — 'ro' | 'en' | 'it' (default 'ro')
 *   ctaHref — href for the final CTA (default: localized /contact)
 *   steps   — override array; otherwise read from i18n howWeWork.steps
 *   header  — override section header (i18n howWeWork.header)
 *   subheader — override subheader (i18n howWeWork.subheader)
 *   ctaText — override CTA label (i18n howWeWork.cta)
 *
 * Renders 5 steps with monospace numbers and an animated connector
 * line between them. Hovering a step highlights it green. Final
 * neon CTA at the bottom.
 */
import { type Locale, t, localizedPath } from '../utils/i18n';

interface Step {
  title: string;
  description: string;
}
interface Props {
  locale?: Locale;
  ctaHref?: string;
  steps?: Step[];
  header?: string;
  subheader?: string;
  ctaText?: string;
  /** legacy: alias for header */
  title?: string;
}
const { locale = 'ro', ctaHref, steps, header, subheader, ctaText, title } = Astro.props;

const block = t<{ header: string; subheader: string; steps: Step[]; cta: string }>(
  locale,
  'howWeWork'
);
const finalSteps = steps ?? block.steps;
const finalHeader = header ?? title ?? block.header;
const finalSub = subheader ?? block.subheader;
const finalCta = ctaText ?? block.cta;
const finalCtaHref = ctaHref ?? localizedPath(locale, '/contact');
---

<section class="reveal border-t border-gpc-border bg-gpc-white">
  <div class="mx-auto max-w-7xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{finalHeader}</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">
      {finalSub}
    </h2>

    <ol class="relative mt-14 grid gap-6 md:grid-cols-5">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute left-0 top-8 hidden h-px w-full md:block"
      >
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-gpc-green/40 to-transparent"></span>
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-gpc-green to-transparent opacity-50 [animation:glow-pulse_2.4s_ease-in-out_infinite]"></span>
      </span>

      {finalSteps.map((step, i) => (
        <li class="group relative">
          <div class="relative z-10 flex flex-col items-start gap-4 border border-gpc-border bg-gpc-card/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gpc-green hover:bg-gpc-card/60 hover:shadow-sm">
            <div class="flex h-12 w-12 items-center justify-center border border-gpc-green/60 bg-gpc-white font-mono text-sm text-gpc-green transition-all group-hover:border-gpc-green group-hover:shadow-sm">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="font-display text-lg text-gpc-ink transition-colors group-hover:text-gpc-green">
              {step.title}
            </h3>
            <p class="font-mono text-sm leading-relaxed text-gpc-ink/70">
              {step.description}
            </p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-14 flex justify-center">
      <a
        href={finalCtaHref}
        class="magnetic group inline-flex items-center gap-3 border border-gpc-green bg-gpc-green/10 px-8 py-4 font-mono text-sm uppercase tracking-[0.25em] text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm"
      >
        {finalCta}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
