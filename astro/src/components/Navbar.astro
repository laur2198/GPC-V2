---
/**
 * Navbar
 *
 * Props:
 *   locale — 'ro' | 'en' | 'it' (required)
 *
 * Features: locale-aware nav links from i18n JSON, sticky on scroll,
 * GREEN PHEONIX wordmark with glyph icon, mobile hamburger off-canvas
 * panel, language switcher dropdown.
 */
import { Image } from 'astro:assets';
import { type Locale, t, localizedPath } from '../utils/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import phoenixMark from '../assets/phoenix-mark.png';

interface Props {
  locale: Locale;
  /** Per-locale slug map for translated-slug pages; forwarded to the
   *  LanguageSwitcher so it links to the correct page, not a 404. */
  hreflangPaths?: Partial<Record<Locale, string>>;
}
const { locale, hreflangPaths } = Astro.props;

interface NavStrings {
  home: string;
  ads: string;
  web: string;
  services?: string;
  prices?: string;
  portfolio: string;
  blog: string;
  about: string;
  contact: string;
}
const nav = t<NavStrings>(locale, 'nav');

// Single "Services" umbrella link — all locales now have /servicii + 6 subs.
// Blog is live; draft skeletons stay out of the build (draft:true) so only
// real posts are reachable.
const links = [
  { href: localizedPath(locale, '/'), label: nav.home },
  { href: localizedPath(locale, '/servicii'), label: nav.services ?? 'Servicii' },
  { href: localizedPath(locale, '/preturi'), label: nav.prices ?? 'Prețuri' },
  { href: localizedPath(locale, '/portofoliu'), label: nav.portfolio },
  { href: localizedPath(locale, '/blog'), label: nav.blog },
  { href: localizedPath(locale, '/despre'), label: nav.about },
  { href: localizedPath(locale, '/contact'), label: nav.contact },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-nav"
  class="sticky top-0 z-40 border-b border-gpc-border bg-gpc-white/95 backdrop-blur-md transition-shadow"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={localizedPath(locale, '/')} class="group flex items-center gap-2">
      <Image
        src={phoenixMark}
        alt=""
        width={28}
        height={28}
        loading="eager"
        class="h-7 w-7 object-contain transition-transform group-hover:rotate-12"
      />
      <span class="font-display text-base tracking-[0.18em] text-gpc-ink">
        GREEN <span class="glow-green">PHEONIX</span>
      </span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => {
        const target = l.href.replace(/\/$/, '') || '/';
        const isActive = current === target;
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'font-mono text-xs uppercase tracking-widest transition-colors',
                isActive ? 'text-gpc-green' : 'text-gpc-ink/80 hover:text-gpc-green',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="flex items-center gap-3">
      <LanguageSwitcher locale={locale} hreflangPaths={hreflangPaths} />
      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-panel"
        aria-expanded="false"
        class="grid h-11 w-11 min-h-[44px] min-w-[44px] place-items-center border border-gpc-border text-gpc-ink hover:border-gpc-green hover:text-gpc-green md:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-panel"
    class="fixed inset-0 z-[70] hidden h-[100dvh] w-full translate-x-full overflow-y-auto bg-gpc-white transition-transform duration-300 md:hidden"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between border-b border-gpc-border px-6 py-4">
      <span class="font-display text-base tracking-[0.18em] text-gpc-ink">
        GREEN <span class="glow-green">PHEONIX</span>
      </span>
      <button
        id="nav-close"
        type="button"
        aria-label="Close menu"
        class="grid h-11 w-11 min-h-[44px] min-w-[44px] place-items-center border border-gpc-border text-gpc-ink hover:border-gpc-green hover:text-gpc-green"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
    <ul class="flex flex-col gap-1 px-6 py-8">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="block border-b border-gpc-border/50 py-4 text-center font-display text-2xl uppercase tracking-wide text-gpc-ink hover:text-gpc-green"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const panel = document.getElementById('mobile-panel');
  const header = document.getElementById('site-nav');

  function open() {
    if (!panel) return;
    panel.classList.remove('hidden');
    requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    panel.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    // Lock background scroll on both html + body for cross-browser safety.
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  }
  function shut() {
    if (!panel) return;
    panel.classList.add('translate-x-full');
    panel.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    setTimeout(() => panel.classList.add('hidden'), 300);
  }

  toggle?.addEventListener('click', open);
  close?.addEventListener('click', shut);
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', shut));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.classList.contains('hidden')) shut();
  });

  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (header) {
        header.classList.toggle('shadow-sm', y > 8);
      }
    },
    { passive: true }
  );
</script>
