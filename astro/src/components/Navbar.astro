---
import type { Locale } from '../utils/i18n';
import { localizedPath, t } from '../utils/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const links = [
  { href: localizedPath(locale, '/'), label: t(locale, 'nav.home') },
  { href: localizedPath(locale, '/servicii-ads'), label: t(locale, 'nav.ads') },
  { href: localizedPath(locale, '/servicii-web'), label: t(locale, 'nav.web') },
  { href: localizedPath(locale, '/portofoliu'), label: t(locale, 'nav.portfolio') },
  { href: localizedPath(locale, '/blog'), label: t(locale, 'nav.blog') },
  { href: localizedPath(locale, '/despre'), label: t(locale, 'nav.about') },
  { href: localizedPath(locale, '/contact'), label: t(locale, 'nav.contact') },
];
---

<header class="sticky top-0 z-50 border-b border-phoenix-gray bg-phoenix-black/80 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={localizedPath(locale, '/')} class="font-display text-xl glow-green">
      GPC
    </a>
    <ul class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="font-mono text-sm text-phoenix-light hover:text-phoenix-green">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <LanguageSwitcher locale={locale} />
  </nav>
</header>
