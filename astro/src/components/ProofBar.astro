---
/**
 * ProofBar
 *
 * Horizontal band of real proof numbers shown directly under the hero.
 * All figures are sourced from real work (Despre experience + the two
 * case-study heroMetrics) — no aggregate volume vanity metrics.
 * Reads the `proofBar` i18n block.
 *
 * Props:
 *   locale — 'ro' | 'en' | 'it' (default 'ro')
 */
import { type Locale, t } from '../utils/i18n';

interface Item {
  value: string;
  label: string;
  context?: string;
}
interface Props {
  locale?: Locale;
}
const { locale = 'ro' } = Astro.props;
const block = t<{ eyebrow: string; items: Item[] }>(locale, 'proofBar');
---

<section class="reveal border-y border-gpc-border bg-gpc-card/20">
  <div class="mx-auto max-w-7xl px-6 py-10 md:py-12">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{block.eyebrow}</p>
    <dl class="mt-6 grid grid-cols-1 gap-px overflow-hidden border border-gpc-border bg-gpc-border sm:grid-cols-3">
      {block.items.map((item) => (
        <div class="flex flex-col bg-gpc-white p-6">
          <dt class="font-display text-4xl leading-none text-gpc-green md:text-5xl">{item.value}</dt>
          <dd class="mt-3 font-mono text-xs uppercase tracking-widest text-gpc-ink/70">{item.label}</dd>
          {item.context && (
            <dd class="mt-1 font-sans text-[0.7rem] italic leading-snug text-gpc-text-secondary/80">{item.context}</dd>
          )}
        </div>
      ))}
    </dl>
  </div>
</section>
