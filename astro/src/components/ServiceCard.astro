---
/**
 * ServiceCard
 *
 * Props:
 *   number      — string, e.g. "01" (rendered large in the corner)
 *   title       — string
 *   description — string
 *   link        — href for the CTA
 *   ctaText     — CTA label (e.g. "Detalii Google Ads")
 *   accentTag   — short tag, e.g. "PAID SEARCH"
 *
 * Cyberpunk dark card with neon green hover glow. Layout: number top-right,
 * accent tag → title → description → CTA arrow at the bottom.
 */
interface Props {
  number: string;
  title: string;
  description: string;
  link: string;
  ctaText: string;
  accentTag: string;
}
const { number, title, description, link, ctaText, accentTag } = Astro.props;
---

<a
  href={link}
  class="reveal group relative flex h-full flex-col justify-between overflow-hidden border border-gpc-border bg-gpc-card/30 p-6 transition-all duration-300 ease-[cubic-bezier(0.165,0.84,0.44,1)] hover:-translate-y-1 hover:border-gpc-green hover:bg-gpc-card/60 hover:shadow-sm"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute right-4 top-2 font-display text-7xl leading-none text-gpc-ink/5 transition-colors group-hover:text-gpc-green/20"
  >
    {number}
  </span>

  <div class="relative">
    <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">
      {accentTag}
    </span>
    <h3 class="mt-5 font-display text-2xl text-gpc-ink transition-colors group-hover:text-gpc-green">
      {title}
    </h3>
    <p class="mt-3 font-sans text-sm leading-relaxed text-gpc-ink/70">
      {description}
    </p>
  </div>

  <div class="relative mt-8 flex items-center justify-between border-t border-gpc-border pt-4 transition-colors group-hover:border-gpc-green/40">
    <span class="font-mono text-xs uppercase tracking-widest text-gpc-ink/80 group-hover:text-gpc-green">
      {ctaText}
    </span>
    <span class="font-mono text-xl text-gpc-green transition-transform group-hover:translate-x-1">
      →
    </span>
  </div>
</a>
