---
/**
 * StickyStackServices
 *
 * Signature "scrollytelling" stack restored from the live HTML
 * (.stack-scroll-wrapper / .sticky-card). Three large colour-coded
 * cards that stack on top of each other as you scroll: each card is
 * `position: sticky` with an incremental `top`, so the previous card
 * stays pinned while the next slides up over it.
 *
 *   Card 01 — Strategie & Audit : dark   (#111111, white text)
 *   Card 02 — Web Dev           : green  (gpc-green, ink text)
 *   Card 03 — Reclame Ads       : red    (gpc-red,  white text)
 *
 * Reads the same `homeServices` i18n block the old 3-col grid used,
 * so RO/EN/IT copy is shared. On mobile the stack collapses to plain
 * stacked sections (no sticky).
 *
 * Props:
 *   locale — 'ro' | 'en' | 'it' (default 'ro')
 */
import { type Locale, t, localizedPath } from '../utils/i18n';

interface ServiceItem {
  number: string;
  title: string;
  description: string;
  ctaText: string;
  accentTag: string;
  link: string;
}
interface Props {
  locale?: Locale;
}
const { locale = 'ro' } = Astro.props;

const block = t<{ header: string; subheader: string; items: ServiceItem[] }>(
  locale,
  'homeServices'
);

const variants = ['card-audit', 'card-web', 'card-ads'] as const;
const cards = block.items.slice(0, 3).map((item, i) => ({
  ...item,
  variant: variants[i] ?? 'card-audit',
  // Incremental sticky offset so each card peeks below the previous one.
  top: 5 + i * 2.5,
}));
---

<section class="reveal border-t border-gpc-border bg-gpc-white">
  <div class="mx-auto max-w-7xl px-6 pt-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{block.header}</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">{block.subheader}</h2>
  </div>

  <div class="stack-scroll-wrapper mx-auto max-w-7xl px-6 pb-20 pt-10">
    {cards.map((card) => (
      <article
        class:list={['sticky-card', card.variant]}
        style={`top: ${card.top}rem;`}
      >
        <span class="sticky-big-type" aria-hidden="true">{card.accentTag}</span>
        <div class="sticky-card-inner">
          <span class="sticky-number">{card.number}</span>
          <h3 class="sticky-title">{card.title}</h3>
          <p class="sticky-desc">{card.description}</p>
          <a class="sticky-link" href={localizedPath(locale, card.link)}>
            {card.ctaText} <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .stack-scroll-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sticky-card {
    position: sticky;
    min-height: 80vh;
    display: flex;
    overflow: hidden;
    border-radius: 20px 20px 0 0;
    padding: 60px 80px;
    box-shadow: 0 -10px 40px rgba(5, 5, 5, 0.18);
  }

  /* Colour variants (live HTML: card-audit / card-web / card-ads). */
  .card-audit {
    background-color: #111111;
    color: #ffffff;
  }
  .card-web {
    background-color: var(--gpc-green);
    color: #050505;
  }
  .card-ads {
    background-color: var(--gpc-red);
    color: #ffffff;
  }

  .sticky-card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 42rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .sticky-number {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .sticky-title {
    margin-top: 1.25rem;
    font-family: 'Oswald', sans-serif;
    font-size: 2.5rem;
    line-height: 1;
    text-transform: uppercase;
    color: inherit;
  }

  .sticky-desc {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.3rem;
    line-height: 1.5;
    opacity: 0.9;
  }

  .sticky-link {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
    transition: gap 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .sticky-link:hover {
    gap: 1rem;
  }

  /* Giant typographic watermark inside each card. */
  .sticky-big-type {
    position: absolute;
    right: 2vw;
    bottom: -2vw;
    font-family: 'Space Mono', monospace;
    font-size: 10vw;
    line-height: 0.8;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.1;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Mobile: plain stacked sections, no sticky. */
  @media (max-width: 768px) {
    .sticky-card {
      position: static;
      min-height: auto;
      padding: 30px;
      border-radius: 16px 16px 0 0;
    }
    .sticky-title {
      font-size: 1.75rem;
    }
    .sticky-desc {
      font-size: 1.05rem;
    }
    .sticky-big-type {
      font-size: 22vw;
    }
  }
</style>
