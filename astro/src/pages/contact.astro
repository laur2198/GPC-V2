---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { type Locale } from '../utils/i18n';

const locale: Locale = 'ro';

const meta = {
  title: 'Contact — Green Phoenix | Brașov',
  description:
    'Discută cu echipa Green Phoenix. Programează un audit gratuit, cere o ofertă personalizată sau scrie-ne pe WhatsApp. Răspuns în 24h lucrătoare.',
};

const businessTypes = [
  { value: '', label: 'Selectează industria' },
  { value: 'medical', label: 'Medical & dentar' },
  { value: 'fitness', label: 'Fitness & wellness' },
  { value: 'beauty', label: 'Beauty & estetică' },
  { value: 'retail', label: 'Retail & fashion' },
  { value: 'food', label: 'Food & HoReCa' },
  { value: 'services', label: 'Services' },
  { value: 'b2b', label: 'B2B' },
  { value: 'real-estate', label: 'Real estate' },
  { value: 'other', label: 'Altul' },
];

const budgetTiers = [
  { value: '', label: 'Selectează bugetul' },
  { value: '<1000', label: 'Sub 1.000 EUR / lună' },
  { value: '1000-3000', label: '1.000 – 3.000 EUR / lună' },
  { value: '3000-5000', label: '3.000 – 5.000 EUR / lună' },
  { value: '5000+', label: '5.000+ EUR / lună' },
];

const interests = [
  { value: 'ads', label: 'Reclame Online (Ads)' },
  { value: 'web', label: 'Site / Landing Page' },
  { value: 'strategy', label: 'Strategie & Funnel' },
  { value: 'audit', label: 'Audit gratuit' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} breadcrumbs={[{ name: 'Contact', href: '/contact' }]}>
  <Hero
    locale={locale}
    variant="compact"
    title="Hai să vorbim."
    subtitle="Programează un audit gratuit, cere o ofertă personalizată sau scrie-ne pe WhatsApp. Răspundem în 24h lucrătoare."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <!-- Sidebar info -->
      <aside class="space-y-8 lg:col-span-4">
        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// CONTACT DIRECT</p>
          <ul class="mt-5 space-y-4 font-mono text-sm">
            <li>
              <p class="text-gpc-ink/60">Telefon</p>
              <a href="tel:+40793650902" class="mt-1 block font-display text-xl text-gpc-ink hover:text-gpc-green">
                +40 793 650 902
              </a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Email</p>
              <a href="mailto:contact@greenpheonixconcept.com" class="mt-1 block font-display text-base text-gpc-ink hover:text-gpc-green">
                contact@greenpheonixconcept.com
              </a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Sediu</p>
              <p class="mt-1 font-display text-base text-gpc-ink">Brașov, România</p>
              <p class="text-xs text-gpc-ink/60">45.6579° N, 25.6012° E</p>
            </li>
          </ul>
        </div>

        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// PROGRAM</p>
          <ul class="mt-5 space-y-2 font-mono text-sm text-gpc-ink/80">
            <li class="flex justify-between"><span>Luni – Vineri</span><span class="text-gpc-green">09:00 – 18:00</span></li>
            <li class="flex justify-between"><span>Sâmbătă – Duminică</span><span class="text-gpc-ink/60">Închis</span></li>
          </ul>
          <p class="mt-4 font-mono text-xs text-gpc-ink/60">
            Răspundem la mesajele primite în afara programului în următoarea zi lucrătoare, până la ora 12:00.
          </p>
        </div>

        <a
          href="https://wa.me/40793650902?text=Salut!%20A%C8%99%20vrea%20s%C4%83%20discut%C4%83m%20despre%20o%20colaborare."
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between gap-3 border border-gpc-green bg-gpc-green/10 px-6 py-4 font-mono text-sm uppercase tracking-widest text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm"
        >
          <span>Scrie-ne pe WhatsApp</span>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4-.1-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5 1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"/>
          </svg>
        </a>
      </aside>

      <!-- Form -->
      <div class="lg:col-span-8">
        {/*
          INSTRUCTIONS — Formspree:
          Înlocuiește [FORM_ID_PLACEHOLDER] din `action` cu ID-ul real generat
          pe https://formspree.io după ce Laurențiu creează formularul. Restul
          (honeypot _gotcha, _next, _subject, _language) este deja configurat.
        */}
        <form
          action="https://formspree.io/f/[FORM_ID_PLACEHOLDER]"
          method="POST"
          novalidate
          class="space-y-6 border border-gpc-border bg-gpc-card/20 p-6 md:p-8"
        >
          <input type="hidden" name="_subject" value="[GPC] Cerere ofertă nouă" />
          <input type="hidden" name="_next" value="https://greenpheonixconcept.com/multumim" />
          <input type="hidden" name="_language" value="ro" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// CERERE OFERTĂ</p>
          <h2 class="font-display text-2xl text-gpc-ink md:text-3xl">
            Spune-ne despre proiect
          </h2>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Nume <span class="text-gpc-green">*</span>
              </span>
              <input
                type="text"
                name="nume"
                required
                autocomplete="name"
                class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none"
                placeholder="ex. Andrei Popescu"
              />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Email <span class="text-gpc-green">*</span>
              </span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none"
                placeholder="andrei@compania.ro"
              />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Telefon
              </span>
              <input
                type="tel"
                name="telefon"
                autocomplete="tel"
                class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none"
                placeholder="+40 7XX XXX XXX"
              />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Tip business
              </span>
              <select
                name="tip_business"
                class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none"
              >
                {businessTypes.map((b) => (
                  <option value={b.value}>{b.label}</option>
                ))}
              </select>
            </label>

            <label class="block md:col-span-2">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Buget lunar estimat
              </span>
              <select
                name="buget_lunar"
                class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none"
              >
                {budgetTiers.map((b) => (
                  <option value={b.value}>{b.label}</option>
                ))}
              </select>
            </label>
          </div>

          <fieldset class="border border-gpc-border bg-gpc-white/40 p-5">
            <legend class="px-2 font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
              Ce te interesează
            </legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {interests.map((it) => (
                <label class="flex cursor-pointer items-center gap-3 border border-gpc-border/60 bg-gpc-card/30 px-4 py-3 font-sans text-sm text-gpc-ink transition-colors hover:border-gpc-green has-[:checked]:border-gpc-green has-[:checked]:bg-gpc-green/10">
                  <input
                    type="checkbox"
                    name="servicii"
                    value={it.value}
                    class="h-4 w-4 accent-gpc-green"
                  />
                  <span>{it.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block">
            <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
              Mesaj
            </span>
            <textarea
              name="mesaj"
              rows="5"
              class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none"
              placeholder="Spune-ne despre obiective, situația actuală sau orice context util."
            ></textarea>
          </label>

          <label class="flex cursor-pointer items-start gap-3 border border-gpc-border bg-gpc-white/40 p-4 font-sans text-xs leading-relaxed text-gpc-ink/80">
            <input
              type="checkbox"
              name="gdpr_consent"
              required
              class="mt-1 h-4 w-4 flex-none accent-gpc-green"
            />
            <span>
              Sunt de acord cu prelucrarea datelor personale conform
              <a href="/politica" class="text-gpc-green underline-offset-2 hover:underline">
                politicii de confidențialitate
              </a>. Datele tale nu sunt partajate cu terți și pot fi șterse oricând.
            </span>
          </label>

          <button
            type="submit"
            class="group inline-flex w-full items-center justify-center gap-3 border border-gpc-green bg-gpc-green/10 px-8 py-4 font-mono text-sm uppercase tracking-[0.25em] text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm md:w-auto"
          >
            Trimite mesaj
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </button>

          <p class="font-mono text-[11px] text-gpc-ink/50">
            * Câmpuri obligatorii. Răspundem în maxim 24h lucrătoare.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// LOCAȚIE</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">Brașov, România</h2>
      <div class="mt-8 aspect-[16/7] w-full overflow-hidden border border-gpc-border">
        <iframe
          title="Hartă Brașov"
          src="https://www.openstreetmap.org/export/embed.html?bbox=25.5712%2C45.6310%2C25.6313%2C45.6850&layer=mapnik&marker=45.6579%2C25.6012"
          loading="lazy"
          class="h-full w-full grayscale invert"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
