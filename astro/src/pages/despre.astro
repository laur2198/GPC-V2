---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import { type Locale, localizedPath } from '../utils/i18n';

const locale: Locale = 'ro';

const meta = {
  title: 'Despre Green Phoenix — Performance marketing fără promisiuni goale',
  description:
    'Suntem o echipă mică din Brașov focusată pe rezultate măsurabile. Construim sisteme de creștere pentru branduri ambițioase: ads, site-uri, tracking corect și decizii bazate pe date.',
};

const values = [
  {
    title: 'Date, nu păreri',
    description:
      'Fiecare decizie e susținută de metrici clare. Dacă nu poate fi măsurat, nu poate fi optimizat — și nu e prioritate.',
  },
  {
    title: 'Transparență totală',
    description:
      'Acces complet la toate conturile, dashboard-uri share-able, rapoarte cu metoda de calcul vizibilă. Niciodată black-box.',
  },
  {
    title: 'Calitate peste volum',
    description:
      'Lucrăm cu maxim 8-10 clienți simultan. Fiecare proiect primește atenție reală, nu shabloane copiate.',
  },
  {
    title: 'Long-term peste hack-uri',
    description:
      'Refuzăm taktici care strică brand-ul pentru un quick win. Construim sisteme care performează pe 12-24 de luni.',
  },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Despre Green Phoenix."
    subtitle="O echipă mică, focusată pe rezultate. Cred că dacă mesajul e clar și sistemele sunt bine puse, restul vine de la sine."
  />

  <!-- Founder story -->
  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="border border-gpc-border bg-gpc-card/30 p-2">
          <img
            src="/founder.png"
            alt="Laurențiu Bogdan, fondator Green Phoenix"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover grayscale"
          />
        </div>
        <div class="mt-4 border-l-2 border-gpc-green pl-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-gpc-green">FOUNDER</p>
          <p class="mt-1 font-display text-xl text-gpc-ink">Laurențiu Bogdan</p>
          <p class="mt-1 font-mono text-xs text-gpc-ink/60">Brașov · Brand & Performance</p>
        </div>
      </aside>

      <div class="space-y-5 font-mono text-base leading-relaxed text-gpc-ink/85 lg:col-span-8">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// STORY</p>
        <h2 class="font-display text-3xl text-gpc-ink md:text-4xl">
          De la branding tradițional la <span class="glow-green">sisteme de creștere digitală</span>
        </h2>

        <p>
          Sunt Laurențiu Bogdan și lucrez în marketing cu o idee simplă în minte: dacă mesajul e clar și brandul e consecvent, rezultatele vin. Am început în branding și design tradițional, am trecut prin proiecte de comunicare pentru companii mari (Reinert, Martinel) și am ajuns la concluzia că diferența între un brand bun și un brand care vinde nu e creativitatea — e disciplina de a măsura, ajusta și itera.
        </p>

        <p>
          În proiectele pentru clienți B2B și DTC am avut ocazia să văd cum se construiește, zi de zi, încrederea într-un brand: prin detalii, prin ritm, prin comunicare atentă, prin decizii care nu sunt doar "creative", ci și asumate. Am învățat că un site frumos fără tracking corect e doar un portfolio. Și că o reclamă bună fără landing optimizat e bani aruncați.
        </p>

        <p>
          Așa s-a născut Green Phoenix: o agenție mică, focusată pe ce contează — sisteme integrate de achiziție clienți. Lucrăm pe ads, site-uri și analytics ca pe o singură unealtă, nu ca pe servicii separate vândute la grămadă. Nu suntem o agenție de "60 de specialiști" — suntem o echipă restrânsă care preferă 8 clienți serioși peste 30 de proiecte tratate superficial.
        </p>

        <p>
          Îmi place să transform informația într-o poveste ușor de înțeles și de urmat: să iau un produs, o ofertă sau o campanie și să o fac relevantă pentru oamenii potriviți. Sunt genul care urmărește imaginea de ansamblu, dar nu ignoră detaliile — pentru că acolo se vede diferența dintre "încă o postare" și o comunicare care chiar construiește.
        </p>

        <p>
          Dacă ai nevoie de cineva care poate ține direcția de brand, livra constant și gândi pragmatic, probabil o să lucrăm bine împreună. Dacă cauți ROAS 10x în prima săptămână, hype și screenshot-uri pe LinkedIn, suntem cea mai proastă opțiune posibilă.
        </p>

        <a
          href={localizedPath(locale, '/contact')}
          class="inline-flex items-center gap-2 border border-gpc-green bg-gpc-green/10 px-6 py-3 font-mono text-sm uppercase tracking-widest text-gpc-green transition-colors hover:bg-gpc-green hover:text-gpc-ink"
        >
          Hai să discutăm →
        </a>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// FILOSOFIE</p>
      <h2 class="mt-3 font-display text-4xl leading-tight md:text-5xl">
        <span class="glow-green">Fără jargon</span>, fără noroc — doar rezultate.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl font-mono text-base leading-relaxed text-gpc-ink/80">
        Marketingul nu e magie. E o disciplină plictisitoare de testat, măsurat, ajustat. Cei mai buni nu sunt cei mai creativi — sunt cei mai consecvenți.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// VALORI</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">
        Patru principii non-negociabile
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {values.map((v, i) => (
          <article class="border border-gpc-border bg-gpc-card/30 p-6 transition-colors hover:border-gpc-green">
            <div class="font-display text-3xl glow-cyan">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="mt-4 font-display text-xl text-gpc-ink">{v.title}</h3>
            <p class="mt-3 font-mono text-sm leading-relaxed text-gpc-ink/70">{v.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    heading="Hai să discutăm."
    subtext="Programează un audit gratuit de 30 de minute. Pleci cu un plan concret, indiferent dacă lucrăm împreună sau nu."
    buttonText="Programează call"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
