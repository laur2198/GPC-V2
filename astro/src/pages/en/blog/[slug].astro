---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import CTA from '../../../components/CTA.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { localizedPath } from '../../../utils/i18n';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const posts = await getCollection('blog', ({ data }) =>
    data.language === 'en' && (showDrafts || !data.draft)
  );
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await entry.render();

const showDraftsRelated = import.meta.env.DEV;
const all = await getCollection('blog', ({ data }) =>
  data.language === 'en' && (showDraftsRelated || !data.draft)
);
const related = all
  .filter((p) => p.slug !== entry.slug && p.data.category === entry.data.category)
  .slice(0, 3);

const formatted = entry.data.publishDate.toISOString().slice(0, 10);
const site = Astro.site ?? new URL('https://greenpheonixconcept.com');
const fullUrl = new URL(Astro.url.pathname, site).toString();
const ogImage = entry.data.heroImage
  ? new URL(entry.data.heroImage, site).toString()
  : new URL('/og-image.jpg', site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  inLanguage: 'en',
  headline: entry.data.title,
  description: entry.data.description,
  image: ogImage,
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: remarkPluginFrontmatter?.lastModified ?? entry.data.publishDate.toISOString(),
  author: { '@type': 'Person', name: entry.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'Green Pheonix',
    logo: { '@type': 'ImageObject', url: new URL('/logo_gpc.svg', site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
  articleSection: entry.data.category,
  keywords: entry.data.tags.join(', '),
};

const shareTargets = [
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(fullUrl)}` },
  { name: 'X / Twitter', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(fullUrl)}` },
  { name: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${entry.data.title} ${fullUrl}`)}` },
];
---

<BaseLayout
  title={`${entry.data.title} | Green Pheonix Blog`}
  description={entry.data.description}
  locale="en"
  image={entry.data.heroImage}
  ogType="article"
>
  <article>
    <header class="relative overflow-hidden border-b border-gpc-border bg-gpc-white">
      <div class="scanline pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl px-6 py-16 lg:py-20">
        <a href={localizedPath('en', '/blog')} class="font-mono text-xs uppercase tracking-widest text-gpc-ink/60 hover:text-gpc-green">
          ← Back to blog
        </a>
        <p class="mt-8 inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">
          {entry.data.category}
        </p>
        <h1 class="mt-5 font-display text-3xl leading-tight md:text-5xl">
          <span class="glow-green">{entry.data.title}</span>
        </h1>
        <div class="mt-6 flex flex-wrap items-center gap-4 font-mono text-sm text-gpc-ink/70">
          <span>{entry.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={entry.data.publishDate.toISOString()}>{formatted}</time>
          {entry.data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span class="flex flex-wrap gap-2">
                {entry.data.tags.map((tg) => (
                  <span class="border border-gpc-border px-2 py-0.5 text-[11px] uppercase tracking-widest text-gpc-ink/60">#{tg}</span>
                ))}
              </span>
            </>
          )}
        </div>
      </div>
    </header>

    {entry.data.heroImage && (
      <div class="border-b border-gpc-border bg-gpc-white">
        <div class="mx-auto max-w-4xl px-6 py-10">
          <img src={entry.data.heroImage} alt={entry.data.title} class="aspect-[16/8] w-full border border-gpc-border object-cover" loading="eager" fetchpriority="high" />
        </div>
      </div>
    )}

    <section class="border-b border-gpc-border bg-gpc-white">
      <div class="mx-auto grid max-w-5xl gap-12 px-6 py-16 lg:grid-cols-12">
        <aside class="lg:col-span-3">
          <div class="sticky top-28 space-y-3">
            <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// SHARE</p>
            <ul class="space-y-2 font-mono text-sm">
              {shareTargets.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="block border border-gpc-border bg-gpc-card/30 px-3 py-2 text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green">{s.name}</a>
                </li>
              ))}
              <li>
                <button type="button" data-copy-url data-url={fullUrl} class="block w-full border border-gpc-border bg-gpc-card/30 px-3 py-2 text-left text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green">
                  <span data-copy-label>Copy link</span>
                </button>
              </li>
            </ul>
          </div>
        </aside>

        <div class="prose prose-invert max-w-none font-sans text-base leading-relaxed text-gpc-ink/85 lg:col-span-9 prose-headings:font-display prose-headings:text-gpc-ink prose-h2:mt-10 prose-h2:text-2xl prose-h2:text-gpc-green prose-h3:text-xl prose-strong:text-gpc-ink prose-a:text-gpc-green prose-li:my-1 prose-code:rounded prose-code:bg-gpc-card/40 prose-code:px-1 prose-code:py-0.5 prose-pre:border prose-pre:border-gpc-border prose-pre:bg-gpc-card/30">
          <Content />
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="border-b border-gpc-border bg-gpc-card/10">
        <div class="mx-auto max-w-7xl px-6 py-16">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// KEEP READING</p>
          <h2 class="mt-3 font-display text-2xl text-gpc-ink md:text-3xl">More from this category</h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <BlogCard
                title={p.data.title}
                description={p.data.description}
                publishDate={p.data.publishDate}
                category={p.data.category}
                heroImage={p.data.heroImage}
                href={localizedPath('en', `/blog/${p.slug}`)}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA
      heading="Put what you read into practice."
      subtext="Book a free audit and let's apply the principles from this article on your business together."
      buttonText="Book audit"
      buttonLink={localizedPath('en', '/contact')}
    />
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          const prev = label.textContent;
          label.textContent = '✓ Copied';
          setTimeout(() => (label.textContent = prev), 1800);
        }
      } catch {
        /* noop */
      }
    });
  });
</script>
