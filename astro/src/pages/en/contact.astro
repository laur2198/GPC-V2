---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { type Locale } from '../../utils/i18n';

const locale: Locale = 'en';

const meta = {
  title: 'Contact — Green Phoenix | Brașov',
  description: 'Talk to the Green Phoenix team. Book a free audit, request a custom quote or write us on WhatsApp. Reply within 24 business hours.',
};

const businessTypes = [
  { value: '', label: 'Select industry' },
  { value: 'medical', label: 'Medical & dental' },
  { value: 'fitness', label: 'Fitness & wellness' },
  { value: 'beauty', label: 'Beauty & aesthetics' },
  { value: 'retail', label: 'Retail & fashion' },
  { value: 'food', label: 'Food & HoReCa' },
  { value: 'services', label: 'Services' },
  { value: 'b2b', label: 'B2B' },
  { value: 'real-estate', label: 'Real estate' },
  { value: 'other', label: 'Other' },
];

const budgetTiers = [
  { value: '', label: 'Select budget' },
  { value: '<1000', label: 'Under EUR 1,000 / month' },
  { value: '1000-3000', label: 'EUR 1,000 – 3,000 / month' },
  { value: '3000-5000', label: 'EUR 3,000 – 5,000 / month' },
  { value: '5000+', label: 'EUR 5,000+ / month' },
];

const interests = [
  { value: 'ads', label: 'Online Ads' },
  { value: 'web', label: 'Site / Landing Page' },
  { value: 'strategy', label: 'Strategy & Funnel' },
  { value: 'audit', label: 'Free audit' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Let's talk."
    subtitle="Book a free audit, request a custom quote or write us on WhatsApp. We reply within 24 business hours."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="space-y-8 lg:col-span-4">
        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// DIRECT CONTACT</p>
          <ul class="mt-5 space-y-4 font-mono text-sm">
            <li>
              <p class="text-gpc-ink/60">Phone</p>
              <a href="tel:+40793650902" class="mt-1 block font-display text-xl text-gpc-ink hover:text-gpc-green">+40 793 650 902</a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Email</p>
              <a href="mailto:contact@greenpheonixconcept.com" class="mt-1 block font-display text-base text-gpc-ink hover:text-gpc-green">contact@greenpheonixconcept.com</a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Office</p>
              <p class="mt-1 font-display text-base text-gpc-ink">Brașov, Romania</p>
              <p class="text-xs text-gpc-ink/60">45.6579° N, 25.6012° E</p>
            </li>
          </ul>
        </div>

        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// HOURS</p>
          <ul class="mt-5 space-y-2 font-mono text-sm text-gpc-ink/80">
            <li class="flex justify-between"><span>Monday – Friday</span><span class="text-gpc-green">09:00 – 18:00</span></li>
            <li class="flex justify-between"><span>Saturday – Sunday</span><span class="text-gpc-ink/60">Closed</span></li>
          </ul>
          <p class="mt-4 font-mono text-xs text-gpc-ink/60">
            Messages received outside business hours are answered the next business day, by 12:00.
          </p>
        </div>

        <a
          href="https://wa.me/40793650902?text=Hi!%20I%27d%20like%20to%20discuss%20a%20possible%20collaboration."
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between gap-3 border border-gpc-green bg-gpc-green/10 px-6 py-4 font-mono text-sm uppercase tracking-widest text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm"
        >
          <span>Message us on WhatsApp</span>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4-.1-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5 1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"/>
          </svg>
        </a>
      </aside>

      <div class="lg:col-span-8">
        <form id="contact-form" data-redirect="/en/thank-you" data-sending="Sending…" data-ok="Message sent ✓" data-err="Something went wrong. Try again or email us at contact@greenpheonixconcept.com." action="https://formspree.io/f/mjgznoda" method="POST" novalidate class="space-y-6 border border-gpc-border bg-gpc-card/20 p-6 md:p-8">
          <input type="hidden" name="_subject" value="New contact from greenpheonixconcept.com EN" />
          <input type="hidden" name="_next" value="https://greenpheonixconcept.com/en/thank-you" />
          <input type="hidden" name="_language" value="en" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// QUOTE REQUEST</p>
          <h2 class="font-display text-2xl text-gpc-ink md:text-3xl">Tell us about the project</h2>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Name <span class="text-gpc-green">*</span>
              </span>
              <input type="text" name="nume" required autocomplete="name" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="e.g. John Smith" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Email <span class="text-gpc-green">*</span>
              </span>
              <input type="email" name="email" required autocomplete="email" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="john@company.com" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Phone</span>
              <input type="tel" name="telefon" autocomplete="tel" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="+40 7XX XXX XXX" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Business type</span>
              <select name="tip_business" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none">
                {businessTypes.map((b) => (<option value={b.value}>{b.label}</option>))}
              </select>
            </label>

            <label class="block md:col-span-2">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Estimated monthly budget</span>
              <select name="buget_lunar" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none">
                {budgetTiers.map((b) => (<option value={b.value}>{b.label}</option>))}
              </select>
            </label>
          </div>

          <fieldset class="border border-gpc-border bg-gpc-white/40 p-5">
            <legend class="px-2 font-mono text-xs uppercase tracking-widest text-gpc-ink/70">What you're interested in</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {interests.map((it) => (
                <label class="flex cursor-pointer items-center gap-3 border border-gpc-border/60 bg-gpc-card/30 px-4 py-3 font-sans text-sm text-gpc-ink transition-colors hover:border-gpc-green has-[:checked]:border-gpc-green has-[:checked]:bg-gpc-green/10">
                  <input type="checkbox" name="servicii" value={it.value} class="h-4 w-4 accent-gpc-green" />
                  <span>{it.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block">
            <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Message</span>
            <textarea name="mesaj" rows="5" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-sans text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="Tell us about goals, current situation, or any useful context."></textarea>
          </label>

          <label class="flex cursor-pointer items-start gap-3 border border-gpc-border bg-gpc-white/40 p-4 font-sans text-xs leading-relaxed text-gpc-ink/80">
            <input type="checkbox" name="gdpr_consent" required class="mt-1 h-4 w-4 flex-none accent-gpc-green" />
            <span>
              I agree with the processing of my personal data per the
              <a href="/en/politica" class="text-gpc-green underline-offset-2 hover:underline">privacy policy</a>.
              Your data isn't shared with third parties and can be erased at any time.
            </span>
          </label>

          <button type="submit" data-submit class="group inline-flex w-full items-center justify-center gap-3 border border-gpc-green bg-gpc-green/10 px-8 py-4 font-mono text-sm uppercase tracking-[0.25em] text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm disabled:cursor-not-allowed disabled:opacity-60 md:w-auto">
            <span data-submit-label>Send message</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </button>

          <p data-form-status role="status" aria-live="polite" hidden class="font-mono text-sm"></p>

          <p class="font-mono text-[11px] text-gpc-ink/50">* Required fields. We reply within 24 business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var btn = form.querySelector('[data-submit]');
      var label = form.querySelector('[data-submit-label]');
      var status = form.querySelector('[data-form-status]');
      var defaultLabel = label ? label.textContent : 'Send message';
      var sendingLabel = form.getAttribute('data-sending') || 'Sending…';
      var okLabel = form.getAttribute('data-ok') || 'Message sent ✓';
      var errLabel = form.getAttribute('data-err') || 'Something went wrong. Try again or email us at contact@greenpheonixconcept.com.';
      var redirect = form.getAttribute('data-redirect') || '/en/thank-you';
      function setStatus(msg, ok) { if (!status) return; status.hidden = false; status.textContent = msg; status.style.color = ok ? 'var(--gpc-green)' : 'var(--gpc-red)'; }
      function fireConversions() {
        try { if (typeof window.gtag !== 'undefined') window.gtag('event', 'form_submit', { event_category: 'engagement', event_label: 'contact_form' }); } catch (e) {}
        try { if (typeof window.fbq !== 'undefined') window.fbq('track', 'Lead'); } catch (e) {}
        try { if (typeof window.ttq !== 'undefined') window.ttq.track('SubmitForm'); } catch (e) {}
      }
      form.addEventListener('submit', function (ev) {
        var hp = form.querySelector('[name="_gotcha"]');
        if (hp && hp.value) { ev.preventDefault(); return; }
        if (!form.checkValidity()) return;
        ev.preventDefault();
        if (btn) btn.disabled = true;
        if (label) label.textContent = sendingLabel;
        if (status) status.hidden = true;
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (res) {
            if (res.ok) { fireConversions(); if (label) label.textContent = okLabel; setStatus(okLabel, true); window.location.href = redirect; }
            else { return res.json().then(function () { throw new Error('formspree'); }); }
          })
          .catch(function () { if (btn) btn.disabled = false; if (label) label.textContent = defaultLabel; setStatus(errLabel, false); });
      });
    })();
  </script>

  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// LOCATION</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">Brașov, Romania</h2>
      <div class="mt-8 aspect-[16/7] w-full overflow-hidden border border-gpc-border">
        <iframe
          title="Brașov map"
          src="https://www.openstreetmap.org/export/embed.html?bbox=25.5712%2C45.6310%2C25.6313%2C45.6850&layer=mapnik&marker=45.6579%2C25.6012"
          loading="lazy"
          class="h-full w-full grayscale invert"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
