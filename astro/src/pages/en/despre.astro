---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Testimonial from '../../components/Testimonial.astro';
import { type Locale, localizedPath } from '../../utils/i18n';

const locale: Locale = 'en';

const meta = {
  title: 'About Green Phoenix — Performance marketing without the fluff',
  description:
    "We're a small team from Brașov focused on measurable results. We build growth systems for ambitious brands: ads, sites, proper tracking and data-driven decisions.",
};

const values = [
  { title: 'Data, not opinions', description: 'Every decision is backed by clear metrics. If it can\'t be measured, it can\'t be optimized — and it\'s not a priority.' },
  { title: 'Full transparency', description: 'Complete access to every account, shareable dashboards, reports with the calculation method visible. Never a black box.' },
  { title: 'Quality over volume', description: 'We work with up to 8-10 clients at any given time. Every project gets real attention, not copied templates.' },
  { title: 'Long-term over hacks', description: 'We refuse tactics that hurt the brand for a quick win. We build systems that perform over 12-24 months.' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="About Green Phoenix."
    subtitle="A small team focused on results. We believe that if the message is clear and the systems are well in place, the rest takes care of itself."
  />

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="border border-phoenix-gray bg-phoenix-gray/30 p-2">
          <img src="/founder.png" alt="Laurențiu Bogdan, founder of Green Phoenix" loading="lazy" class="aspect-[4/5] w-full object-cover grayscale" />
        </div>
        <div class="mt-4 border-l-2 border-phoenix-green pl-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-phoenix-green">FOUNDER</p>
          <p class="mt-1 font-display text-xl text-phoenix-light">Laurențiu Bogdan</p>
          <p class="mt-1 font-mono text-xs text-phoenix-light/60">Brașov · Brand & Performance</p>
        </div>
      </aside>

      <div class="space-y-5 font-mono text-base leading-relaxed text-phoenix-light/85 lg:col-span-8">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// STORY</p>
        <h2 class="font-display text-3xl text-phoenix-light md:text-4xl">
          From traditional branding to <span class="glow-green">digital growth systems</span>
        </h2>

        <p>
          I'm Laurențiu Bogdan and I work in marketing with one simple idea in mind: if the message is clear and the brand is consistent, the results follow. I started in branding and traditional design, went through communication projects for big companies (Reinert, Martinel) and arrived at the conclusion that the difference between a great brand and a brand that sells isn't creativity — it's the discipline to measure, adjust and iterate.
        </p>

        <p>
          On B2B and DTC client projects I had the chance to see how trust gets built into a brand, day after day: through details, rhythm, careful communication, and decisions that aren't just "creative" but accountable. I learned that a beautiful site without proper tracking is just a portfolio. And that a great ad without an optimized landing is wasted money.
        </p>

        <p>
          That's how Green Phoenix was born: a small agency focused on what matters — integrated client-acquisition systems. We treat ads, sites and analytics as a single tool, not as separate services bundled together. We're not an agency of "60 specialists" — we're a tight team that prefers 8 serious clients over 30 superficial projects.
        </p>

        <p>
          I like turning information into a story that's easy to understand and follow: take a product, an offer or a campaign and make it relevant to the right people. I'm the kind of person who watches the big picture but doesn't ignore details — because that's where the difference between "yet another post" and communication that actually builds shows up.
        </p>

        <p>
          If you need someone who can hold the brand direction, deliver consistently and think pragmatically, we'll probably work well together. If you're looking for 10x ROAS in the first week, hype and LinkedIn screenshots, we're the worst possible option.
        </p>

        <a href={localizedPath(locale, '/contact')} class="inline-flex items-center gap-2 border border-phoenix-green bg-phoenix-green/10 px-6 py-3 font-mono text-sm uppercase tracking-widest text-phoenix-green transition-colors hover:bg-phoenix-green hover:text-phoenix-black">
          Let's talk →
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// PHILOSOPHY</p>
      <h2 class="mt-3 font-display text-4xl leading-tight md:text-5xl">
        <span class="glow-green">No jargon</span>, no luck — just results.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl font-mono text-base leading-relaxed text-phoenix-light/80">
        Marketing isn't magic. It's a boring discipline of testing, measuring, adjusting. The best aren't the most creative — they're the most consistent.
      </p>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// VALUES</p>
      <h2 class="mt-3 font-display text-3xl text-phoenix-light md:text-4xl">Four non-negotiable principles</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {values.map((v, i) => (
          <article class="border border-phoenix-gray bg-phoenix-gray/30 p-6 transition-colors hover:border-phoenix-green">
            <div class="font-display text-3xl glow-cyan">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-4 font-display text-xl text-phoenix-light">{v.title}</h3>
            <p class="mt-3 font-mono text-sm leading-relaxed text-phoenix-light/70">{v.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <Testimonial
        quote="In 4 months they tripled qualified leads and ROAS jumped from 2.1 to 5.8. But the most valuable thing is that, finally, I understand what works and why."
        author="Andrei P."
        role="CEO"
        company="DTC Brand"
        rating={5}
      />
    </div>
  </section>

  <CTA
    heading="Let's talk."
    subtext="Book a free 30-minute audit. You leave with a concrete plan, whether we work together or not."
    buttonText="Book a call"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
