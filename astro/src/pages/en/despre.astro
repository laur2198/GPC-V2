---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import { type Locale, t, localizedPath } from '../../utils/i18n';

const locale: Locale = 'en';

interface AboutCopy {
  meta: { title: string; description: string };
  h1: string;
  subHeadline: string;
  section1: { title: string; p1: string; p2: string; p3: string };
  section2: {
    title: string;
    belief1: { title: string; body: string };
    belief2: { title: string; body: string };
    belief3: { title: string; body: string };
    belief4: { title: string; body: string };
  };
  section3: { title: string; p1: string; p2: string; p3: string; p4: string };
  section4: { title: string; bg1: string; bg2: string; bg3: string; bg4: string };
  section5: { title: string; body: string; cta: string };
}
const about = t<AboutCopy>(locale, 'about');

const beliefs = [about.section2.belief1, about.section2.belief2, about.section2.belief3, about.section2.belief4];
const howWork = [about.section3.p1, about.section3.p2, about.section3.p3, about.section3.p4];
const background = [about.section4.bg1, about.section4.bg2, about.section4.bg3, about.section4.bg4];
---

<BaseLayout title={about.meta.title} description={about.meta.description} locale={locale}>
  <Hero locale={locale} variant="compact" title={about.h1} subtitle={about.subHeadline} />

  <!-- Section 1 — Why Green Pheonix exists -->
  <section class="reveal border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="border border-gpc-border bg-gpc-card/30 p-2">
          <img
            src="/founder.png"
            alt="Laurentiu Bogdan, founder of Green Pheonix"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover grayscale"
          />
        </div>
        <div class="mt-4 border-l-2 border-gpc-green pl-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-gpc-green">FOUNDER</p>
          <p class="mt-1 font-display text-xl text-gpc-ink">Laurentiu Bogdan</p>
          <p class="mt-1 font-mono text-xs text-gpc-ink/60">Brașov · Brand &amp; Performance</p>
        </div>
      </aside>

      <div class="space-y-5 lg:col-span-8">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// {about.section1.title}</p>
        <h2 class="font-display text-3xl text-gpc-ink md:text-4xl">{about.section1.title}</h2>
        <p class="font-sans text-base leading-relaxed text-gpc-ink/85">{about.section1.p1}</p>
        <p class="font-sans text-base leading-relaxed text-gpc-ink/85">{about.section1.p2}</p>
        <p class="font-sans text-base leading-relaxed text-gpc-ink/85">{about.section1.p3}</p>
      </div>
    </div>
  </section>

  <!-- Section 2 — The four core beliefs -->
  <section class="reveal border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// BELIEFS</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">{about.section2.title}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {beliefs.map((b, i) => (
          <article class="border border-gpc-border bg-gpc-white p-6 transition-colors duration-300 hover:border-gpc-green md:p-8">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-sm uppercase tracking-[0.3em] text-gpc-green">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span aria-hidden="true" class="font-mono text-xs text-gpc-ink/30">/</span>
            </div>
            <h3 class="mt-3 font-mono text-sm font-bold uppercase tracking-[0.15em] text-gpc-ink">
              {b.title}
            </h3>
            <p class="mt-4 font-sans text-base leading-relaxed text-gpc-text-secondary">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3 — How I work -->
  <section class="reveal border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// {about.section3.title}</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">{about.section3.title}</h2>
      <div class="mt-8 space-y-5">
        {howWork.map((p) => (
          <p class="font-sans text-base leading-relaxed text-gpc-ink/85">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4 — Background -->
  <section class="reveal border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// {about.section4.title}</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">{about.section4.title}</h2>
      <ul class="mt-8 divide-y divide-gpc-border border-y border-gpc-border">
        {background.map((item, i) => (
          <li class="flex gap-4 py-5">
            <span class="font-mono text-sm uppercase tracking-[0.2em] text-gpc-green">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="font-sans text-base leading-relaxed text-gpc-ink/85">{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA
    heading={about.section5.title}
    subtext={about.section5.body}
    buttonText={about.section5.cta}
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
