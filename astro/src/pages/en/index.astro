---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import StickyStackServices from '../../components/StickyStackServices.astro';
import Philosophy from '../../components/Philosophy.astro';
import TrustBar from '../../components/TrustBar.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';
import { type Locale, t, localizedPath } from '../../utils/i18n';
import { getPageCopy } from '../../utils/content';

const locale: Locale = 'en';
const meta = getPageCopy(locale, 'home').meta;

const cs = t<{ header: string; subheader: string; viewAll: string }>(locale, 'caseStudies');

const faq = t<{ header: string; items: { question: string; answer: string }[] }>(locale, 'faq');

const finalCta = t<{ heading: string; subtext: string; buttonText: string }>(locale, 'finalCta');

const testimonialsUi = t<{ header: string; viewCase: string }>(locale, 'testimonials');

const aboutTeaser = t<{ header: string; title: string; description: string; ctaText: string }>(locale, 'aboutTeaser');

const showDrafts = import.meta.env.DEV;
const byOrder = (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999);
const publishable = ({ data }) => showDrafts || !data.draft;
let allCs = (await getCollection('caseStudies', ({ data, ...rest }) =>
  data.language === locale && publishable({ data, ...rest })
)).sort(byOrder);
// Fall back to Romanian case studies when none exist in this locale yet.
if (allCs.length === 0) {
  allCs = (await getCollection('caseStudies', ({ data, ...rest }) =>
    data.language === 'ro' && publishable({ data, ...rest })
  )).sort(byOrder);
}
const previewCs = allCs.slice(0, 2);

// Real client testimonials sourced from case studies. We only show quotes
// from real named people — entries that are data-source attributions
// (e.g. "Date Meta Ads Manager") or pending placeholders are excluded.
const PLACEHOLDER = /în curs de confirmare|todo|lorem|placeholder|provizoriu|date meta ads manager|ads manager/i;
const realTestimonials = allCs
  .filter((cs) => {
    const tm = cs.data.testimonial;
    return tm && tm.quote && tm.author && !PLACEHOLDER.test(tm.quote) && !PLACEHOLDER.test(tm.author);
  })
  .map((cs) => ({
    quote: cs.data.testimonial!.quote,
    author: cs.data.testimonial!.author,
    role: cs.data.testimonial!.role ?? '',
    href: localizedPath(locale, `/portofoliu/${cs.slug.replace(/-(en|it)$/, '')}`),
  }));
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} faqSchema={faq.items}>
  <Hero locale={locale} />
  <ProofBar locale={locale} />
  <TrustBar locale={locale} />

  <Philosophy locale={locale} />

  <StickyStackServices locale={locale} />

  <HowWeWork locale={locale} />

  {previewCs.length > 0 && (
    <section class="reveal border-t border-gpc-border bg-gpc-white">
      <div class="mx-auto max-w-7xl px-6 py-20">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{cs.header}</p>
            <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">{cs.subheader}</h2>
          </div>
          <a
            href={localizedPath(locale, '/portofoliu')}
            class="hidden font-mono text-xs uppercase tracking-widest text-gpc-ink/70 hover:text-gpc-green md:inline-flex"
          >
            {cs.viewAll} →
          </a>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {previewCs.map((entry) => {
            const d = entry.data;
            const heroMetric = d.heroMetric ?? (d.results[0] ? { value: d.results[0].value, label: d.results[0].metric } : undefined);
            const kpis = d.results.map((r) => ({ label: r.metric, value: r.value }));
            const meta = d.location ?? d.duration ?? d.industry;
            const summary = d.anonymized ? `${d.industry} · ${meta}` : `${d.client} · ${meta}`;
            return (
              <CaseStudyCard
                title={d.title}
                industry={d.industry}
                image={d.images?.hero ?? d.heroImage}
                imageAlt={d.imageAlt}
                summary={summary}
                link={localizedPath(entry.data.language, `/portofoliu/${entry.slug.replace(/-(en|it)$/, '')}`)}
                heroMetric={heroMetric}
                kpis={kpis}
              />
            );
          })}
        </div>
        <a
          href={localizedPath(locale, '/portofoliu')}
          class="mt-10 inline-flex font-mono text-xs uppercase tracking-widest text-gpc-ink/70 hover:text-gpc-green md:hidden"
        >
          {cs.viewAll} →
        </a>
      </div>
    </section>
  )}

  {realTestimonials.length > 0 && (
    <section class="reveal border-t border-gpc-border bg-gpc-white">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{testimonialsUi.header}</p>
        <div class="mt-10 space-y-10">
          {realTestimonials.map((tm) => (
            <figure class="border-l-4 border-gpc-green bg-gpc-card/20 p-8 text-left md:p-10">
              <blockquote class="font-sans text-[1.15rem] italic leading-relaxed text-gpc-ink md:text-[1.35rem]">
                „{tm.quote}”
              </blockquote>
              <figcaption class="mt-6">
                <span class="font-mono text-sm font-bold uppercase tracking-wider text-gpc-ink">{tm.author}</span>
                {tm.role && <span class="mt-1 block font-mono text-xs text-gpc-text-secondary">{tm.role}</span>}
                {tm.href && (
                  <a href={tm.href} class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-gpc-green hover:underline">
                    {testimonialsUi.viewCase} <span aria-hidden="true">→</span>
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="reveal border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">{aboutTeaser.header}</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">{aboutTeaser.title}</h2>
      <p class="mt-5 max-w-2xl font-sans text-base leading-relaxed text-gpc-ink/80">{aboutTeaser.description}</p>
      <a
        href={localizedPath(locale, '/despre')}
        class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-gpc-green hover:underline"
      >
        {aboutTeaser.ctaText} →
      </a>
    </div>
  </section>

  <FAQ items={faq.items} title={faq.header} schema={false} />

  <CTA
    heading={finalCta.heading}
    subtext={finalCta.subtext}
    buttonText={finalCta.buttonText}
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
