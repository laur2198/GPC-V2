---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import CaseStudyCard from '../../../components/CaseStudyCard.astro';
import CTA from '../../../components/CTA.astro';
import { getCollection } from 'astro:content';
import { type Locale, localizedPath } from '../../../utils/i18n';

const locale: Locale = 'en';

const meta = {
  title: 'Portfolio — Case Studies | Green Pheonix',
  description:
    'Real projects, measured results. Case studies from sports and home-improvement (natural stone) — performance marketing, branding and websites built on data.',
};

const showDrafts = import.meta.env.DEV;
const all = (await getCollection('caseStudies', ({ data }) =>
  data.language === locale && (showDrafts || !data.draft)
)).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const industries = Array.from(new Set(all.map((cs) => cs.data.industry))).sort();
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Our work."
    subtitle="A selection of recent projects with client-validated numbers. More case studies will be published as we receive approvals."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-16">
      {industries.length > 1 && (
        <div class="flex flex-wrap items-center gap-3" role="group" aria-label="Industry filter">
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// FILTER</span>
          <button type="button" data-filter="all" class="border border-gpc-green bg-gpc-green/10 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-green" aria-pressed="true">All</button>
          {industries.map((ind) => (
            <button type="button" data-filter={ind} class="border border-gpc-border bg-gpc-card/30 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green" aria-pressed="false">{ind}</button>
          ))}
        </div>
      )}

      {all.length === 0 ? (
        <p class="py-12 text-center font-mono text-gpc-ink/60">Case studies coming soon.</p>
      ) : (
        <div id="cs-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {all.map((cs) => {
            const r = cs.data.results;
            const kpis: [{ label: string; value: string }, { label: string; value: string }, { label: string; value: string }] = [
              r[0] ? { label: r[0].metric, value: r[0].value } : { label: 'Duration', value: cs.data.duration },
              r[1] ? { label: r[1].metric, value: r[1].value } : { label: 'Services', value: String(cs.data.services.length) },
              r[2] ? { label: r[2].metric, value: r[2].value } : { label: 'Industry', value: cs.data.industry },
            ];
            const meta = cs.data.location ?? cs.data.duration ?? cs.data.industry;
            const summary = cs.data.anonymized ? `${cs.data.industry} · ${meta}` : `${cs.data.client} · ${meta}`;
            return (
              <div data-industry={cs.data.industry}>
                <CaseStudyCard title={cs.data.title} industry={cs.data.industry} image={cs.data.heroImage} summary={summary} link={localizedPath(locale, `/portofoliu/${cs.slug.replace(/-(en|it)$/, '')}`)} kpis={kpis} />
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <CTA
    heading="Want to be the next case study?"
    subtext="Book a free audit and let's see if we can deliver similar results in your industry."
    buttonText="Book audit"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#cs-grid > [data-industry]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('border-gpc-green', active);
        b.classList.toggle('bg-gpc-green/10', active);
        b.classList.toggle('text-gpc-green', active);
        b.classList.toggle('border-gpc-border', !active);
        b.classList.toggle('bg-gpc-card/30', !active);
        b.classList.toggle('text-gpc-ink/80', !active);
      });
      cards.forEach((card) => {
        const ind = card.dataset.industry ?? '';
        card.style.display = target === 'all' || ind === target ? '' : 'none';
      });
    });
  });
</script>
