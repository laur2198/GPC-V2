---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { type Locale, localizedPath } from '../../utils/i18n';

const locale: Locale = 'en';

const meta = {
  title: 'Online Ads Services — Meta, Google, TikTok | Green Phoenix',
  description:
    'Performance marketing agency from Brașov. Meta Ads, Google Ads and TikTok Ads optimized on ROAS, with clean technical setup and transparent reports. Free audit.',
};

const platforms = [
  {
    number: '01',
    title: 'Meta Ads (Facebook & Instagram)',
    accentTag: 'SOCIAL',
    description: 'Awareness, lead-gen and e-commerce strategies, with weekly creative and audience testing using first-party data.',
    ctaText: 'See how we run Meta',
    link: '#meta-detail',
  },
  {
    number: '02',
    title: 'Google Ads (Search, PMax, Shopping)',
    accentTag: 'PAID SEARCH',
    description: 'Commercial-intent campaigns, structured brand vs non-brand, with PMax for e-commerce and Demand Gen where it fits.',
    ctaText: 'See how we run Google',
    link: '#google-detail',
  },
  {
    number: '03',
    title: 'TikTok Ads',
    accentTag: 'VIDEO',
    description: 'Native content shot weekly, hooks A/B-tested, and Spark Ads scaling for Gen Z & Millennial audiences.',
    ctaText: 'See how we run TikTok',
    link: '#tiktok-detail',
  },
  {
    number: '04',
    title: 'Integrated strategy',
    accentTag: 'STRATEGY',
    description: 'The right mix across platforms, server-side conversions, and a funnel with retargeting on every touchpoint.',
    ctaText: 'See our strategy',
    link: '#strategy-detail',
  },
];

const industries = [
  'Medical & dental',
  'Fitness & wellness',
  'Beauty & aesthetics',
  'Retail & fashion',
  'Food & HoReCa',
  'B2B services',
  'Real estate',
  'Automotive',
  'DTC e-commerce',
];

const pricing = [
  {
    tag: 'STARTER',
    title: 'Set-up + management 1 platform',
    price: 'from EUR 600 / month',
    bullets: ['Initial audit', '1 platform (Meta or Google)', 'Min. media budget EUR 1,000', 'Monthly report'],
  },
  {
    tag: 'GROWTH',
    title: 'Meta + Google mix + creative',
    price: 'from EUR 1,200 / month',
    bullets: ['2 integrated platforms', 'Weekly creative iteration', 'Server-side conversions', 'Bi-weekly report + call'],
  },
  {
    tag: 'SCALE',
    title: 'Full strategy + TikTok',
    price: 'from EUR 2,000 / month',
    bullets: ['3 platforms + retargeting', 'Creative studio + UGC', 'Looker Studio dashboard', 'Weekly call + Slack'],
  },
];

const faqItems = [
  {
    question: "What's the minimum recommended ad budget?",
    answer:
      'We recommend a minimum of EUR 1,000 / month media + agency fee. Below that threshold algorithms get stuck in the learning phase and it makes more sense to fix the offer, the site and tracking first.',
  },
  {
    question: 'How fast do results show up?',
    answer:
      'First signals appear within 48–72h after launch. Real optimization is visible in 2–4 weeks, once we have enough data to make decisions on creative, audiences and landing pages.',
  },
  {
    question: 'How do we measure ROAS correctly?',
    answer:
      'Server-side conversions (Meta CAPI, Google Enhanced Conversions), GA4 with custom events and a Looker Studio dashboard with blended ROAS — never just numbers from inside the platforms.',
  },
  {
    question: 'Which industries do you work best with?',
    answer:
      'Medical & dental, fitness, beauty, retail, food, B2B services, real estate and automotive. We have proven playbooks for each, but everything gets adapted to brand specifics.',
  },
  {
    question: 'Is there a minimum contract period?',
    answer:
      'We recommend 3 months for stable results, but we never lock the client in. Contracts have a 30-day notice and no exit fees.',
  },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} faqSchema={faqItems}>
  <Hero
    locale={locale}
    variant="compact"
    title="Online ads that bring clients, not just impressions."
    subtitle="Meta Ads, Google Ads and TikTok Ads run by a team obsessed with ROAS, with clean technical setup and transparent reports. Free audit on existing accounts."
    ctaLabel="Book a free audit"
    ctaHref={localizedPath(locale, '/contact')}
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="sticky top-28 font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// WHAT WE DO</p>
      </div>
      <div class="space-y-6 font-mono text-base leading-relaxed text-gpc-ink/85 lg:col-span-8">
        <h2 class="font-display text-3xl text-gpc-ink md:text-4xl">
          Performance marketing without the fluff, calibrated on <span class="glow-green">real ROAS</span>.
        </h2>
        <p>
          At Green Phoenix we build customer-acquisition systems that work predictably, not isolated campaigns that look great in screenshots. We work on three main platforms — Meta, Google and TikTok — and combine them into a coherent funnel, with messaging and offers that talk to each other.
        </p>
        <p>
          The major difference vs. a classic agency is that we look at the whole chain: offer, landing page, tracking, creative, audiences, bid strategy, post-click experience. If any of them is broken, the rest doesn't matter. That's why every engagement starts with a full audit, not with a media-budget proposal.
        </p>
        <p>
          In the first 7 days you get a concrete plan: what's working, what's broken, what needs to be fixed before we spend a euro, and which KPIs we'll track. After that we move into weekly execution: launch, optimize, scale carefully and report transparently — data from platforms + GA4 + blended view, not just what's convenient to show.
        </p>
        <p>
          We don't promise 10x ROAS in the first month. We do promise that at 90 days you'll know exactly what works, what doesn't, what we tested and what's next. If we're the right fit, you'll stay; if not, the audit is yours and you can use it with anyone.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// PLATFORMS</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">
        What we set up, optimize, and report on
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {platforms.map((p) => (
          <ServiceCard number={p.number} title={p.title} description={p.description} link={localizedPath(locale, '/contact')} ctaText={p.ctaText} accentTag={p.accentTag} />
        ))}
      </div>
    </div>
  </section>

  <section id="meta-detail" class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">META ADS</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Facebook & Instagram, calibrated on action</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          On Meta we run a clean account structure: an Awareness campaign with broad interests for reach and quality signal, a Conversion campaign with Advantage+ Audiences for acquisition, and separate retargeting on pixel events — view content, add to cart, checkout, post-purchase for cross-sell.
        </p>
        <p>
          Conversions go through Meta Conversions API server-side (Stape or custom implementation), not just the pixel. That way we lose less signal on iOS 14+, optimize better and get accurate attribution data.
        </p>
        <p>
          Creative-wise we iterate weekly: 4-6 new angles, different hooks, varied formats (single image, carousel, reel, UGC). Everything goes through a budget-controlled testing phase before scaling on what performs.
        </p>
      </div>
    </div>
  </section>

  <section id="google-detail" class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">GOOGLE ADS</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Search, PMax, Shopping — on real intent</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          Search Ads start from real intent research: Keyword Planner, Search Terms from existing accounts, SERP suggestions, plus external tools (Ahrefs / Semrush). We strictly separate brand from non-brand and run dedicated campaigns by match type.
        </p>
        <p>
          Performance Max works for high-volume e-commerce and lead-gen, but we use it with segmented Asset Groups (not a single "all-in-one"), seed audiences and brand exclusions. We add Search Themes for tighter intent control.
        </p>
        <p>
          For Shopping, we optimize the feed (titles, attributes, GTINs, images), not just bidding. A clean feed beats aggressive bidding every time.
        </p>
      </div>
    </div>
  </section>

  <section id="tiktok-detail" class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">TIKTOK ADS</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Native content that doesn't feel like an ad</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          On TikTok, format beats bid strategy. We produce 4-8 weekly variations with distinct hooks (problem-agitate, demo, comparison, social proof) and test Spark Ads from real brand accounts or partnered creators.
        </p>
        <p>
          Technical setup includes TikTok Pixel, server-side Events API and Advanced Matching for better attribution. For e-commerce we also integrate TikTok Shop where the category supports it.
        </p>
      </div>
    </div>
  </section>

  <section id="strategy-detail" class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">INTEGRATED STRATEGY</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Coherent funnel, not silos</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          The three platforms don't live separately. Audiences feed each other: TikTok produces top-of-funnel content and signal, Meta converts mid-funnel with calibrated retargeting, and Google captures direct intent and brand search created by the other channels.
        </p>
        <p>
          Tracking is unified: GA4 as the source of truth for blended attribution, server-side conversions on every platform, Looker Studio dashboard with daily KPIs. So you don't just see platform-level ROAS — you see the real efficiency of every euro invested.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// INDUSTRIES</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">Who we work best with</h2>
      <p class="mt-4 max-w-2xl font-mono text-sm leading-relaxed text-gpc-ink/70">
        We have proven playbooks for the industries below. Everything is adapted to the brand — never copy-paste.
      </p>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-3">
        {industries.map((i) => (
          <li class="border border-gpc-border bg-gpc-card/30 px-4 py-3 font-mono text-sm uppercase tracking-wider text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green">
            <span class="mr-2 text-gpc-green">›</span>{i}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// PRICING</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">Transparent, scalable packages</h2>
      <p class="mt-4 max-w-2xl font-mono text-sm leading-relaxed text-gpc-ink/70">
        The prices below are the agency fee; media budget is separate and gets set based on goals. Every package includes direct dashboard access and monthly reporting.
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {pricing.map((p, i) => (
          <article class:list={['flex flex-col border bg-gpc-card/30 p-6', i === 1 ? 'border-gpc-green shadow-sm' : 'border-gpc-border']}>
            <span class="inline-block self-start border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">{p.tag}</span>
            <h3 class="mt-5 font-display text-xl text-gpc-ink">{p.title}</h3>
            <p class="mt-3 font-display text-2xl glow-green">{p.price}</p>
            <ul class="mt-6 flex-1 space-y-2 font-mono text-sm text-gpc-ink/80">
              {p.bullets.map((b) => (
                <li class="flex gap-2"><span class="text-gpc-green">✓</span><span>{b}</span></li>
              ))}
            </ul>
            <a href={localizedPath(locale, '/contact')} class="mt-8 inline-flex items-center justify-center border border-gpc-green px-4 py-3 font-mono text-xs uppercase tracking-widest text-gpc-green transition-colors hover:bg-gpc-green hover:text-gpc-ink">
              Get a quote
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork locale={locale} />

  <FAQ items={faqItems} title="FREQUENTLY ASKED — ADS" schema={false} />

  <CTA
    heading="Want a free audit on your campaigns?"
    subtext="In 60 minutes we identify the main leaks and what can be optimized immediately. You leave with a plan, whether we work together or not."
    buttonText="Book a free audit"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
