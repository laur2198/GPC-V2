---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';
import { getPageCopy } from '../../utils/content';
import { localizedPath } from '../../utils/i18n';

const locale = 'en' as const;
const c = getPageCopy(locale, 'servicii-ads');

const services = [
  { title: 'Google Search Ads', description: 'Keyword campaigns with high commercial intent.' },
  { title: 'Performance Max', description: 'AI automation across all Google inventory.' },
  { title: 'Meta Ads', description: 'Facebook & Instagram for leads and e-commerce.' },
  { title: 'TikTok Ads', description: 'Native content for Gen Z & Millennial audiences.' },
  { title: 'Tracking & GA4', description: 'Proper event setup and server-side conversions.' },
  { title: 'ROAS Optimization', description: 'A/B testing creatives, audiences and landing pages.' },
];
---

<BaseLayout title={c.meta.title} description={c.meta.description} locale={locale}>
  <Hero title={c.hero.title} subtitle={c.hero.subtitle} ctaLabel={c.hero.ctaLabel} ctaHref={localizedPath(locale, '/contact')} />
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <ServiceCard title={s.title} description={s.description} />)}
    </div>
  </section>
  <CTA title="Want a free audit on your campaigns?" description="In one hour we identify what can be optimized." ctaLabel="Book audit" ctaHref={localizedPath(locale, '/contact')} />
</BaseLayout>
