---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustBar from '../components/TrustBar.astro';
import HowWeWork from '../components/HowWeWork.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Testimonial from '../components/Testimonial.astro';
import { type Locale, t, localizedPath } from '../utils/i18n';
import { getPageCopy } from '../utils/content';

const locale: Locale = 'ro';
const meta = getPageCopy(locale, 'home').meta;

interface ServiceItem {
  number: string;
  title: string;
  description: string;
  ctaText: string;
  accentTag: string;
}
const services = t<{ header: string; subheader: string; items: ServiceItem[] }>(locale, 'services');
const faq = t<{ header: string; items: { question: string; answer: string }[] }>(locale, 'faq');
const finalCta = t<{ heading: string; subtext: string; buttonText: string }>(locale, 'finalCta');

interface TestimonialItem {
  quote: string;
  author: string;
  role: string;
  company: string;
  rating: number;
}
const testimonials = t<{ header: string; items: TestimonialItem[] }>(locale, 'testimonials');
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} faqSchema={faq.items}>
  <Hero locale={locale} />
  <TrustBar locale={locale} />

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">{services.header}</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-phoenix-light md:text-4xl">{services.subheader}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.items.map((s) => (
          <ServiceCard
            number={s.number}
            title={s.title}
            description={s.description}
            link={localizedPath(locale, '/servicii-ads')}
            ctaText={s.ctaText}
            accentTag={s.accentTag}
          />
        ))}
      </div>
    </div>
  </section>

  <HowWeWork locale={locale} />

  {testimonials.items.length > 0 && (
    <section class="border-t border-phoenix-gray bg-phoenix-black">
      <div class="mx-auto max-w-4xl px-6 py-20">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">{testimonials.header}</p>
        <div class="mt-10 space-y-6">
          {testimonials.items.map((tm) => (
            <Testimonial quote={tm.quote} author={tm.author} role={tm.role} company={tm.company} rating={tm.rating} />
          ))}
        </div>
      </div>
    </section>
  )}

  <FAQ items={faq.items} title={faq.header} schema={false} />

  <CTA
    heading={finalCta.heading}
    subtext={finalCta.subtext}
    buttonText={finalCta.buttonText}
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
