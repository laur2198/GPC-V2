---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import CTA from '../../../components/CTA.astro';
import { getCollection } from 'astro:content';
import { type Locale, localizedPath } from '../../../utils/i18n';

const locale: Locale = 'it';

const meta = {
  title: 'Blog — Performance marketing & web | Green Phoenix',
  description:
    'Articoli pragmatici su Google Ads, Meta, TikTok, GA4, Core Web Vitals e CRO. Senza fronzoli, senza opinioni — solo ciò che funziona.',
};

const showDrafts = import.meta.env.DEV;
const posts = (await getCollection('blog', ({ data }) =>
  data.language === locale && (showDrafts || !data.draft)
)).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const categories = Array.from(new Set(posts.map((p) => p.data.category))).sort();
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Blog."
    subtitle="Insight e guide su performance marketing, web e analytics. Tutto ciò che pubblichiamo qui è testato sul campo, non sintetizzato da altri articoli."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-16">
      {categories.length > 1 && (
        <div class="flex flex-wrap items-center gap-3" role="group" aria-label="Filtro categoria">
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// FILTRO</span>
          <button type="button" data-filter="all" class="border border-gpc-green bg-gpc-green/10 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-green" aria-pressed="true">Tutti</button>
          {categories.map((cat) => (
            <button type="button" data-filter={cat} class="border border-gpc-border bg-gpc-card/30 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green" aria-pressed="false">{cat}</button>
          ))}
        </div>
      )}

      {posts.length === 0 ? (
        <p class="py-12 text-center font-mono text-gpc-ink/60">Articoli in arrivo.</p>
      ) : (
        <div id="blog-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <div data-category={p.data.category}>
              <BlogCard
                title={p.data.title}
                description={p.data.description}
                publishDate={p.data.publishDate}
                category={p.data.category}
                heroImage={p.data.heroImage}
                href={localizedPath(locale, `/blog/${p.slug}`)}
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <CTA
    heading="Vuoi parlare del tuo progetto?"
    subtext="Applichiamo gli stessi principi degli articoli su progetti reali. Prenota un audit gratuito."
    buttonText="Prenota audit"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#blog-grid > [data-category]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('border-gpc-green', active);
        b.classList.toggle('bg-gpc-green/10', active);
        b.classList.toggle('text-gpc-green', active);
        b.classList.toggle('border-gpc-border', !active);
        b.classList.toggle('bg-gpc-card/30', !active);
        b.classList.toggle('text-gpc-ink/80', !active);
      });
      cards.forEach((card) => {
        const cat = card.dataset.category ?? '';
        card.style.display = target === 'all' || cat === target ? '' : 'none';
      });
    });
  });
</script>
