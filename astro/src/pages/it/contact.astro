---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { type Locale } from '../../utils/i18n';

const locale: Locale = 'it';

const meta = {
  title: 'Contatti — Green Phoenix | Brașov',
  description: 'Parla con il team di Green Phoenix. Prenota un audit gratuito, richiedi un preventivo personalizzato o scrivici su WhatsApp. Risposta entro 24h lavorative.',
};

const businessTypes = [
  { value: '', label: 'Seleziona settore' },
  { value: 'medical', label: 'Medico & dentistico' },
  { value: 'fitness', label: 'Fitness & wellness' },
  { value: 'beauty', label: 'Beauty & estetica' },
  { value: 'retail', label: 'Retail & fashion' },
  { value: 'food', label: 'Food & HoReCa' },
  { value: 'services', label: 'Servizi' },
  { value: 'b2b', label: 'B2B' },
  { value: 'real-estate', label: 'Real estate' },
  { value: 'other', label: 'Altro' },
];

const budgetTiers = [
  { value: '', label: 'Seleziona budget' },
  { value: '<1000', label: 'Sotto 1.000 EUR / mese' },
  { value: '1000-3000', label: '1.000 – 3.000 EUR / mese' },
  { value: '3000-5000', label: '3.000 – 5.000 EUR / mese' },
  { value: '5000+', label: '5.000+ EUR / mese' },
];

const interests = [
  { value: 'ads', label: 'Annunci Online' },
  { value: 'web', label: 'Sito / Landing Page' },
  { value: 'strategy', label: 'Strategia & Funnel' },
  { value: 'audit', label: 'Audit gratuito' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Parliamone."
    subtitle="Prenota un audit gratuito, richiedi un preventivo personalizzato o scrivici su WhatsApp. Rispondiamo entro 24h lavorative."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="space-y-8 lg:col-span-4">
        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// CONTATTO DIRETTO</p>
          <ul class="mt-5 space-y-4 font-mono text-sm">
            <li>
              <p class="text-gpc-ink/60">Telefono</p>
              <a href="tel:+40793650902" class="mt-1 block font-display text-xl text-gpc-ink hover:text-gpc-green">+40 793 650 902</a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Email</p>
              <a href="mailto:contact@greenpheonixconcept.com" class="mt-1 block font-display text-base text-gpc-ink hover:text-gpc-green">contact@greenpheonixconcept.com</a>
            </li>
            <li>
              <p class="text-gpc-ink/60">Sede</p>
              <p class="mt-1 font-display text-base text-gpc-ink">Brașov, Romania</p>
              <p class="text-xs text-gpc-ink/60">45.6579° N, 25.6012° E</p>
            </li>
          </ul>
        </div>

        <div class="border border-gpc-border bg-gpc-card/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// ORARI</p>
          <ul class="mt-5 space-y-2 font-mono text-sm text-gpc-ink/80">
            <li class="flex justify-between"><span>Lunedì – Venerdì</span><span class="text-gpc-green">09:00 – 18:00</span></li>
            <li class="flex justify-between"><span>Sabato – Domenica</span><span class="text-gpc-ink/60">Chiuso</span></li>
          </ul>
          <p class="mt-4 font-mono text-xs text-gpc-ink/60">
            Ai messaggi ricevuti fuori orario rispondiamo il giorno lavorativo successivo entro le 12:00.
          </p>
        </div>

        <a
          href="https://wa.me/40793650902?text=Ciao!%20Vorrei%20parlare%20di%20una%20possibile%20collaborazione."
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between gap-3 border border-gpc-green bg-gpc-green/10 px-6 py-4 font-mono text-sm uppercase tracking-widest text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm"
        >
          <span>Scrivici su WhatsApp</span>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4-.1-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5 1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"/>
          </svg>
        </a>
      </aside>

      <div class="lg:col-span-8">
        {/*
          INSTRUCTIONS — Formspree:
          Sostituisci [FORM_ID_PLACEHOLDER] in `action` con l'ID reale da
          formspree.io. Honeypot, _next, _subject e _language sono già pronti.
        */}
        <form action="https://formspree.io/f/[FORM_ID_PLACEHOLDER]" method="POST" novalidate class="space-y-6 border border-gpc-border bg-gpc-card/20 p-6 md:p-8">
          <input type="hidden" name="_subject" value="[GPC] Nuova richiesta progetto" />
          <input type="hidden" name="_next" value="https://greenpheonixconcept.com/it/multumim" />
          <input type="hidden" name="_language" value="it" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// RICHIESTA PREVENTIVO</p>
          <h2 class="font-display text-2xl text-gpc-ink md:text-3xl">Raccontaci del progetto</h2>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Nome <span class="text-gpc-green">*</span>
              </span>
              <input type="text" name="nume" required autocomplete="name" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="es. Marco Rossi" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">
                Email <span class="text-gpc-green">*</span>
              </span>
              <input type="email" name="email" required autocomplete="email" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="marco@azienda.it" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Telefono</span>
              <input type="tel" name="telefon" autocomplete="tel" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="+39 3XX XXX XXXX" />
            </label>

            <label class="block">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Tipo di business</span>
              <select name="tip_business" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none">
                {businessTypes.map((b) => (<option value={b.value}>{b.label}</option>))}
              </select>
            </label>

            <label class="block md:col-span-2">
              <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Budget mensile stimato</span>
              <select name="buget_lunar" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink transition-colors focus:border-gpc-green focus:outline-none">
                {budgetTiers.map((b) => (<option value={b.value}>{b.label}</option>))}
              </select>
            </label>
          </div>

          <fieldset class="border border-gpc-border bg-gpc-white/40 p-5">
            <legend class="px-2 font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Cosa ti interessa</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              {interests.map((it) => (
                <label class="flex cursor-pointer items-center gap-3 border border-gpc-border/60 bg-gpc-card/30 px-4 py-3 font-mono text-sm text-gpc-ink transition-colors hover:border-gpc-green has-[:checked]:border-gpc-green has-[:checked]:bg-gpc-green/10">
                  <input type="checkbox" name="servicii" value={it.value} class="h-4 w-4 accent-gpc-green" />
                  <span>{it.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block">
            <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-gpc-ink/70">Messaggio</span>
            <textarea name="mesaj" rows="5" class="w-full border border-gpc-border bg-gpc-white px-4 py-3 font-mono text-sm text-gpc-ink placeholder-gpc-text-muted/40 transition-colors focus:border-gpc-green focus:outline-none" placeholder="Raccontaci di obiettivi, situazione attuale o qualsiasi contesto utile."></textarea>
          </label>

          <label class="flex cursor-pointer items-start gap-3 border border-gpc-border bg-gpc-white/40 p-4 font-mono text-xs leading-relaxed text-gpc-ink/80">
            <input type="checkbox" name="gdpr_consent" required class="mt-1 h-4 w-4 flex-none accent-gpc-green" />
            <span>
              Acconsento al trattamento dei miei dati personali secondo l'
              <a href="/it/politica" class="text-gpc-green underline-offset-2 hover:underline">informativa sulla privacy</a>.
              I tuoi dati non vengono condivisi con terze parti e possono essere cancellati in qualsiasi momento.
            </span>
          </label>

          <button type="submit" class="group inline-flex w-full items-center justify-center gap-3 border border-gpc-green bg-gpc-green/10 px-8 py-4 font-mono text-sm uppercase tracking-[0.25em] text-gpc-green shadow-sm transition-all hover:bg-gpc-green hover:text-gpc-ink hover:shadow-sm md:w-auto">
            Invia messaggio
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </button>

          <p class="font-mono text-[11px] text-gpc-ink/50">* Campi obbligatori. Rispondiamo entro 24h lavorative.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// LOCATION</p>
      <h2 class="mt-3 font-display text-3xl text-gpc-ink md:text-4xl">Brașov, Romania</h2>
      <div class="mt-8 aspect-[16/7] w-full overflow-hidden border border-gpc-border">
        <iframe
          title="Mappa Brașov"
          src="https://www.openstreetmap.org/export/embed.html?bbox=25.5712%2C45.6310%2C25.6313%2C45.6850&layer=mapnik&marker=45.6579%2C25.6012"
          loading="lazy"
          class="h-full w-full grayscale invert"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
