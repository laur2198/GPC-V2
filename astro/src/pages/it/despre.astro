---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Testimonial from '../../components/Testimonial.astro';
import { type Locale, localizedPath } from '../../utils/i18n';

const locale: Locale = 'it';

const meta = {
  title: 'Chi siamo — Green Phoenix | Performance marketing senza fronzoli',
  description:
    'Siamo un piccolo team da Brașov focalizzato sui risultati misurabili. Costruiamo sistemi di crescita per brand ambiziosi: ads, siti, tracking corretto e decisioni basate sui dati.',
};

const values = [
  { title: 'Dati, non opinioni', description: "Ogni decisione si basa su metriche chiare. Se non si può misurare, non si può ottimizzare — e non è una priorità." },
  { title: 'Trasparenza totale', description: 'Accesso completo a tutti gli account, dashboard condivisibili, report con il metodo di calcolo visibile. Mai una black box.' },
  { title: 'Qualità sopra il volume', description: 'Lavoriamo con massimo 8-10 clienti contemporaneamente. Ogni progetto riceve attenzione reale, non template copiati.' },
  { title: 'Long-term sopra gli hack', description: 'Rifiutiamo tattiche che danneggiano il brand per un quick win. Costruiamo sistemi che performano per 12-24 mesi.' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Chi siamo."
    subtitle="Un piccolo team focalizzato sui risultati. Crediamo che se il messaggio è chiaro e i sistemi sono ben costruiti, il resto arriva da solo."
  />

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="border border-phoenix-gray bg-phoenix-gray/30 p-2">
          <img src="/founder.png" alt="Laurențiu Bogdan, fondatore di Green Phoenix" loading="lazy" class="aspect-[4/5] w-full object-cover grayscale" />
        </div>
        <div class="mt-4 border-l-2 border-phoenix-green pl-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-phoenix-green">FONDATORE</p>
          <p class="mt-1 font-display text-xl text-phoenix-light">Laurențiu Bogdan</p>
          <p class="mt-1 font-mono text-xs text-phoenix-light/60">Brașov · Brand & Performance</p>
        </div>
      </aside>

      <div class="space-y-5 font-mono text-base leading-relaxed text-phoenix-light/85 lg:col-span-8">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// STORIA</p>
        <h2 class="font-display text-3xl text-phoenix-light md:text-4xl">
          Dal branding tradizionale a <span class="glow-green">sistemi di crescita digitale</span>
        </h2>

        <p>
          Mi chiamo Laurențiu Bogdan e lavoro nel marketing con un'idea semplice in mente: se il messaggio è chiaro e il brand è coerente, i risultati arrivano. Ho iniziato nel branding e nel design tradizionale, ho attraversato progetti di comunicazione per grandi aziende (Reinert, Martinel) e sono arrivato a una conclusione: la differenza tra un brand bello e un brand che vende non è la creatività — è la disciplina di misurare, regolare e iterare.
        </p>

        <p>
          Nei progetti per clienti B2B e DTC ho potuto vedere come si costruisce, giorno per giorno, la fiducia in un brand: tramite dettagli, ritmo, comunicazione attenta, decisioni che non sono solo "creative" ma assunte fino in fondo. Ho imparato che un sito bello senza tracking corretto è solo un portfolio. E che un'ottima ad senza una landing ottimizzata sono soldi sprecati.
        </p>

        <p>
          Così è nata Green Phoenix: un'agenzia piccola, focalizzata su ciò che conta — sistemi integrati di acquisizione clienti. Lavoriamo su ads, siti e analytics come su un unico strumento, non come servizi separati venduti in blocco. Non siamo un'agenzia da "60 specialisti" — siamo un team ristretto che preferisce 8 clienti seri a 30 progetti trattati superficialmente.
        </p>

        <p>
          Mi piace trasformare l'informazione in una storia facile da capire e seguire: prendere un prodotto, un'offerta o una campagna e renderla rilevante per le persone giuste. Sono il tipo di persona che osserva il quadro generale ma non ignora i dettagli — perché lì si vede la differenza tra "l'ennesimo post" e una comunicazione che davvero costruisce.
        </p>

        <p>
          Se hai bisogno di qualcuno che possa tenere la direzione del brand, consegnare con costanza e pensare in modo pragmatico, probabilmente lavoreremo bene insieme. Se cerchi un ROAS 10x nella prima settimana, hype e screenshot su LinkedIn, siamo l'opzione peggiore possibile.
        </p>

        <a href={localizedPath(locale, '/contact')} class="inline-flex items-center gap-2 border border-phoenix-green bg-phoenix-green/10 px-6 py-3 font-mono text-sm uppercase tracking-widest text-phoenix-green transition-colors hover:bg-phoenix-green hover:text-phoenix-black">
          Parliamone →
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// FILOSOFIA</p>
      <h2 class="mt-3 font-display text-4xl leading-tight md:text-5xl">
        <span class="glow-green">Senza fronzoli</span>, senza fortuna — solo risultati.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl font-mono text-base leading-relaxed text-phoenix-light/80">
        Il marketing non è magia. È una disciplina noiosa di test, misurazione, aggiustamento. I migliori non sono i più creativi — sono i più costanti.
      </p>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// VALORI</p>
      <h2 class="mt-3 font-display text-3xl text-phoenix-light md:text-4xl">Quattro principi non negoziabili</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {values.map((v, i) => (
          <article class="border border-phoenix-gray bg-phoenix-gray/30 p-6 transition-colors hover:border-phoenix-green">
            <div class="font-display text-3xl glow-cyan">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-4 font-display text-xl text-phoenix-light">{v.title}</h3>
            <p class="mt-3 font-mono text-sm leading-relaxed text-phoenix-light/70">{v.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <Testimonial
        quote="In 4 mesi hanno triplicato i lead qualificati e il ROAS è passato da 2.1 a 5.8. Ma la cosa più preziosa è che, finalmente, capisco cosa funziona e perché."
        author="Andrei P."
        role="CEO"
        company="DTC Brand"
        rating={5}
      />
    </div>
  </section>

  <CTA
    heading="Parliamone."
    subtext="Prenota un audit gratuito di 30 minuti. Esci con un piano concreto, anche se non lavoriamo insieme."
    buttonText="Prenota una call"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
