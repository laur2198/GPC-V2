---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import TrustBar from '../../components/TrustBar.astro';
import { type Locale, t, localizedPath } from '../../utils/i18n';
import { getPageCopy } from '../../utils/content';

const locale: Locale = 'it';
const meta = getPageCopy(locale, 'home').meta;

interface ServiceItem {
  number: string;
  title: string;
  description: string;
  ctaText: string;
  accentTag: string;
}
const services = t<{ header: string; subheader: string; items: ServiceItem[] }>(locale, 'services');
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero locale={locale} />
  <TrustBar />
  <section class="mx-auto max-w-7xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">{services.header}</p>
    <h2 class="mt-3 font-display text-3xl text-phoenix-light md:text-4xl">{services.subheader}</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.items.map((s) => (
        <ServiceCard
          number={s.number}
          title={s.title}
          description={s.description}
          link={localizedPath(locale, '/servicii-ads')}
          ctaText={s.ctaText}
          accentTag={s.accentTag}
        />
      ))}
    </div>
  </section>
</BaseLayout>
