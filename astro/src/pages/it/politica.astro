---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getPageCopy } from '../../utils/content';

const locale = 'it' as const;
const c = getPageCopy(locale, 'politica');
---

<BaseLayout title={c.meta.title} description={c.meta.description} locale={locale}>
  <Hero title={c.hero.title} subtitle={c.hero.subtitle} />
  <article class="mx-auto max-w-3xl space-y-6 px-6 py-16 font-mono text-sm leading-relaxed text-phoenix-light/80">
    <h2 class="font-display text-2xl text-phoenix-light">1. Dati raccolti</h2>
    <p>Raccogliamo solo i dati necessari per rispondere alle tue richieste: nome, email, contenuto del messaggio.</p>
    <h2 class="font-display text-2xl text-phoenix-light">2. Cookie</h2>
    <p>Utilizziamo cookie analitici (GA4) e di marketing per migliorare l’esperienza. Puoi gestire le preferenze in qualsiasi momento.</p>
    <h2 class="font-display text-2xl text-phoenix-light">3. I tuoi diritti</h2>
    <p>Hai diritto di accesso, rettifica, cancellazione e portabilità ai sensi del GDPR. Contattaci per qualsiasi richiesta.</p>
  </article>
</BaseLayout>
