---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { type Locale, localizedPath } from '../../utils/i18n';

const locale: Locale = 'it';

const meta = {
  title: 'Servizi Web — Siti & Landing Page che convertono | Green Pheonix',
  description:
    'Siti e landing page costruiti su Astro, WordPress o Shopify. Performance 95+ Lighthouse, SEO tecnica, CRO e tracking GA4 server-side. Audit gratuito.',
};

const sections = [
  { number: '01', title: 'Landing Page', accentTag: 'CONVERSION', description: 'Pagine di conversione costruite intorno a una sola offerta, ottimizzate sui Core Web Vitals e A/B testing.', ctaText: 'Dettagli landing', link: '#landing-detail' },
  { number: '02', title: 'Siti completi', accentTag: 'CORPORATE', description: 'Siti vetrina, blog e portfolio su Astro / Next o WordPress headless, con struttura SEO-friendly.', ctaText: 'Dettagli sito', link: '#site-detail' },
  { number: '03', title: 'Ottimizzazione CRO', accentTag: 'CRO', description: "A/B test su pagine esistenti, heatmap, session replay, ipotesi e iterazioni settimanali sul funnel.", ctaText: 'Dettagli CRO', link: '#cro-detail' },
  { number: '04', title: 'Tracking & Analytics', accentTag: 'DATA', description: 'GA4, GTM, conversioni server-side, dashboard Looker Studio e Consent Mode v2 implementati correttamente.', ctaText: 'Dettagli tracking', link: '#tracking-detail' },
];

const stack = ['Astro', 'Next.js', 'WordPress', 'Shopify', 'Tailwind CSS', 'Sanity / Storyblok', 'Vercel / Netlify', 'Cloudflare'];

const pricing = [
  { tag: 'LANDING', title: 'Una pagina, un\'offerta', price: 'da 1.200 EUR', bullets: ['Design + dev', 'Mobile-first', 'GA4 + tag manager', 'Consegna in 2 settimane'] },
  { tag: 'SITO', title: 'Vetrina 5-10 pagine', price: 'da 3.500 EUR', bullets: ['Design + dev', 'CMS per editing', 'SEO tecnica', 'Tracking completo'] },
  { tag: 'E-COMMERCE', title: 'Shop Shopify / Woo', price: 'da 5.500 EUR', bullets: ['Theme custom', 'Integrazione pagamenti', 'Email + retargeting', 'Tracking server-side'] },
];

const faqItems = [
  { question: 'Quanto dura la realizzazione di un sito?', answer: 'Landing page: 2 settimane. Sito vetrina 5-10 pagine: 4-6 settimane. E-commerce: 6-10 settimane. Le variabili principali sono i tempi di approvazione del copy e la disponibilità di foto / video.' },
  { question: 'Su quale piattaforma consigliate di costruire?', answer: "Dipende dall'obiettivo. Per velocità + SEO + landing: Astro o Next. Per blog editato da team non tecnici: WordPress headless. Per e-commerce DTC: Shopify. La raccomandazione arriva dall'audit degli obiettivi, non al contrario." },
  { question: 'Il sito include la SEO?', answer: 'La SEO tecnica è inclusa di default: schema, sitemap, canonical, robots, Core Web Vitals, struttura URL. La SEO di contenuti (articoli, ottimizzazione on-page) è un progetto separato e si quota a parte.' },
  { question: "Cosa significa ottimizzazione CRO?", answer: "Conversion Rate Optimization significa aumentare la percentuale di visitatori che compiono l'azione desiderata (acquistare, compilare un form). Lavoriamo con heatmap, session replay (Hotjar / Microsoft Clarity), ipotesi documentate e A/B testing." },
  { question: 'Offrite anche manutenzione dopo il lancio?', answer: 'Sì. Pacchetto manutenzione separato: aggiornamenti, sicurezza, backup, monitoring uptime, piccoli interventi mensili. Da 200 EUR / mese.' },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} faqSchema={faqItems}>
  <Hero
    locale={locale}
    variant="compact"
    title="Siti veloci, ottimizzati per vendere."
    subtitle="Landing page e siti completi costruiti per performance e conversione. Stack moderno, SEO tecnica e tracking corretto di default. Audit gratuito sul sito esistente."
    ctaLabel="Richiedi audit gratuito web"
    ctaHref={localizedPath(locale, '/contact')}
  />

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="sticky top-28 font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// COSA FACCIAMO</p>
      </div>
      <div class="space-y-6 font-mono text-base leading-relaxed text-phoenix-light/85 lg:col-span-8">
        <h2 class="font-display text-3xl text-phoenix-light md:text-4xl">
          Siti per il <span class="glow-green">business</span>, non per l'ego.
        </h2>
        <p>
          Costruiamo siti che fanno bene una sola cosa: portare risultati di business. Niente animazioni da showreel, niente parallax che caricano in 8 secondi, niente hero-video da 50MB. Performance, chiarezza, conversione.
        </p>
        <p>
          Lo stack dipende dall'obiettivo. Per landing page e siti marketing scegliamo Astro — genera HTML statico, zero JS di default, 95+ Lighthouse senza sforzo. Per blog e contenuti editati dal team, consigliamo WordPress headless o un CMS (Sanity, Storyblok). Per e-commerce DTC, Shopify è il default.
        </p>
        <p>
          A prescindere dallo stack, i fondamentali restano: struttura semantica, SEO tecnica pulita, tracking server-side dal giorno 1, Core Web Vitals in zona verde, design mobile-first e design system riusabile. Tutto ciò che consegniamo arriva con documentazione e accesso completo — mai dependency lock-in.
        </p>
        <p>
          Il processo è chiaro: 1) audit & strategia (1 settimana), 2) wireframe & UX (1-2 settimane), 3) design visivo (1-2 settimane), 4) dev & integrazione (2-6 settimane), 5) QA + lancio (1 settimana), 6) ottimizzazione post-lancio. Ogni tappa ha un risultato tangibile che approvi prima di procedere.
        </p>
        <p>
          Dopo il lancio gestiamo tracking, dashboard e CRO continuo. Un sito non è un progetto "build & forget" — è un asset che va mantenuto, misurato e ottimizzato.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// MODULI</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-phoenix-light md:text-4xl">Quattro direzioni, un processo</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {sections.map((s) => (
          <ServiceCard number={s.number} title={s.title} description={s.description} link={localizedPath(locale, '/contact')} ctaText={s.ctaText} accentTag={s.accentTag} />
        ))}
      </div>
    </div>
  </section>

  <section id="landing-detail" class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-phoenix-cyan/40 bg-phoenix-cyan/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-phoenix-cyan">LANDING PAGE</span>
        <h3 class="mt-4 font-display text-2xl text-phoenix-light md:text-3xl">Un'offerta, una pagina, una decisione</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-phoenix-light/80 lg:col-span-8">
        <p>
          Le nostre landing page non sono mini-siti. Sono costruite intorno a una sola offerta e a un solo CTA. Ogni riga di copy, ogni immagine e ogni modulo esistono per portare il visitatore più vicino alla conversione.
        </p>
        <p>
          Stack di default: Astro per HTML statico + zero JavaScript sulle pagine pubbliche, Tailwind per il design system, form connesso a HubSpot / Mailchimp / Webhook custom, GA4 con eventi custom.
        </p>
        <p>
          Lavoriamo con copywriter quando serve, ma il copy core lo gestiamo internamente perché è legato direttamente alla strategia di funnel — non è qualcosa da delegare senza contesto.
        </p>
      </div>
    </div>
  </section>

  <section id="site-detail" class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-phoenix-cyan/40 bg-phoenix-cyan/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-phoenix-cyan">SITI COMPLETI</span>
        <h3 class="mt-4 font-display text-2xl text-phoenix-light md:text-3xl">Siti marketing & corporate</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-phoenix-light/80 lg:col-span-8">
        <p>
          Per siti vetrina da 5-15 pagine, scegliamo uno stack che bilancia velocità e facilità di editing: Astro + Sanity headless, WordPress con tema custom ottimizzato, o Next + Storyblok per casi più complessi.
        </p>
        <p>
          Ogni sito include: struttura SEO-friendly con schema markup, sitemap automatica, OG tags dinamici, robots.txt corretto, redirect 301 dal sito vecchio, dashboard di tracking in Looker Studio.
        </p>
        <p>
          Per contenuti multilingua (RO/EN/IT), usiamo un CMS con supporto nativo e hreflang automatico. Niente plugin configurati male che rovinano la SEO.
        </p>
      </div>
    </div>
  </section>

  <section id="cro-detail" class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-phoenix-cyan/40 bg-phoenix-cyan/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-phoenix-cyan">CRO</span>
        <h3 class="mt-4 font-display text-2xl text-phoenix-light md:text-3xl">Conversion Rate Optimization</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-phoenix-light/80 lg:col-span-8">
        <p>
          Su siti esistenti con traffico, il primo intervento efficace non è più budget — è CRO. Un aumento dell'1% del tasso di conversione si traduce direttamente in 10-30% di clienti in più, senza un euro in più sulle ads.
        </p>
        <p>
          Il processo: installazione heatmap + session replay (Hotjar o Microsoft Clarity gratuito), audit dei friction point, prioritizzazione ipotesi (per impatto stimato e sforzo), A/B testing con Convert o VWO, reporting settimanale sulla statistical significance, non sul vibe.
        </p>
      </div>
    </div>
  </section>

  <section id="tracking-detail" class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-phoenix-cyan/40 bg-phoenix-cyan/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-phoenix-cyan">TRACKING</span>
        <h3 class="mt-4 font-display text-2xl text-phoenix-light md:text-3xl">GA4, GTM, conversioni server-side</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-phoenix-light/80 lg:col-span-8">
        <p>
          Il tracking corretto è la base di ogni decisione di marketing. Implementiamo GA4 con eventi custom (non solo pageview), GTM con data layer pulito, Consent Mode v2 GDPR-compliant, conversioni server-side su Meta CAPI e Google Enhanced Conversions.
        </p>
        <p>
          Per l'e-commerce, integriamo l'Enhanced Ecommerce completo con il funnel reale (view item → add to cart → begin checkout → purchase) e attribuiamo i canali col modello data-driven.
        </p>
        <p>
          Consegniamo tutte le dashboard in Looker Studio, con accesso condivisibile per il team e schema KPI chiaro.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-black">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// STACK</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-phoenix-light md:text-4xl">Tecnologie che usiamo ogni giorno</h2>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {stack.map((s) => (
          <li class="border border-phoenix-gray bg-phoenix-gray/30 px-4 py-3 font-mono text-sm uppercase tracking-wider text-phoenix-light/80 transition-colors hover:border-phoenix-green hover:text-phoenix-green">
            <span class="mr-2 text-phoenix-green">›</span>{s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-phoenix-gray bg-phoenix-gray/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// PREZZI</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-phoenix-light md:text-4xl">Pacchetti di partenza</h2>
      <p class="mt-4 max-w-2xl font-mono text-sm leading-relaxed text-phoenix-light/70">
        I prezzi qui sotto sono il punto di partenza. L'offerta finale dipende dal numero di pagine, integrazioni (CRM, pagamento, ERP) e volume di contenuti.
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {pricing.map((p, i) => (
          <article class:list={['flex flex-col border bg-phoenix-gray/30 p-6', i === 1 ? 'border-phoenix-green shadow-[0_0_28px_rgba(0,255,148,0.18)]' : 'border-phoenix-gray']}>
            <span class="inline-block self-start border border-phoenix-cyan/40 bg-phoenix-cyan/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-phoenix-cyan">{p.tag}</span>
            <h3 class="mt-5 font-display text-xl text-phoenix-light">{p.title}</h3>
            <p class="mt-3 font-display text-2xl glow-green">{p.price}</p>
            <ul class="mt-6 flex-1 space-y-2 font-mono text-sm text-phoenix-light/80">
              {p.bullets.map((b) => (
                <li class="flex gap-2"><span class="text-phoenix-green">✓</span><span>{b}</span></li>
              ))}
            </ul>
            <a href={localizedPath(locale, '/contact')} class="mt-8 inline-flex items-center justify-center border border-phoenix-green px-4 py-3 font-mono text-xs uppercase tracking-widest text-phoenix-green transition-colors hover:bg-phoenix-green hover:text-phoenix-black">
              Richiedi preventivo
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork locale={locale} />

  <FAQ items={faqItems} title="DOMANDE FREQUENTI — WEB" schema={false} />

  <CTA
    heading="Vuoi un audit gratuito sul tuo sito?"
    subtext="Verifichiamo Core Web Vitals, SEO tecnica, tracking, UX e friction point. Esci con un report concreto e 3-5 azioni prioritarie."
    buttonText="Prenota audit gratuito"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
