---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath } from '../utils/i18n';

const meta = {
  title: 'Mulțumim! | Green Pheonix Concept',
  description: 'Mesajul tău a fost trimis. Te contactăm în maxim 24 de ore lucrătoare.',
};
---

<BaseLayout title={meta.title} description={meta.description} locale="ro" noindex hideCookieBanner>
  <section class="relative min-h-[60vh] border-b border-phoenix-gray bg-phoenix-black">
    <div class="scanline pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-phoenix-cyan">// TRANSMISSION_OK</p>
      <h1 class="mt-4 font-display text-4xl leading-tight md:text-6xl">
        <span class="glow-green">Mulțumim!</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl font-mono text-base leading-relaxed text-phoenix-light/85 md:text-lg">
        Mesajul tău a fost trimis cu succes. Te contactăm în maxim <span class="text-phoenix-green">24 de ore lucrătoare</span>, de obicei mult mai repede.
      </p>
      <p class="mx-auto mt-3 max-w-xl font-mono text-sm text-phoenix-light/60">
        Între timp, dacă vrei să discutăm imediat, ne găsești și pe WhatsApp.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={localizedPath('ro', '/')}
          class="border border-phoenix-green bg-phoenix-green/10 px-6 py-3 font-mono text-sm uppercase tracking-widest text-phoenix-green transition-colors hover:bg-phoenix-green hover:text-phoenix-black"
        >
          Înapoi acasă →
        </a>
        <a
          href="https://wa.me/40793650902"
          target="_blank"
          rel="noopener"
          class="border border-phoenix-light/40 px-6 py-3 font-mono text-sm uppercase tracking-widest text-phoenix-light transition-colors hover:border-phoenix-cyan hover:text-phoenix-cyan"
        >
          Scrie-ne pe WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
