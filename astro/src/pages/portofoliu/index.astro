---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';
import { type Locale, localizedPath } from '../../utils/i18n';

const locale: Locale = 'ro';

const meta = {
  title: 'Portofoliu — Studii de caz | Green Phoenix',
  description:
    'Proiecte reale, rezultate cuantificate. Studii de caz din transport, medical, e-commerce și B2B — performance marketing și site-uri construite pe date.',
};

const showDrafts = import.meta.env.DEV;
const all = (await getCollection('caseStudies', ({ data }) =>
  data.language === locale && (showDrafts || !data.draft)
)).sort((a, b) => (a.data.title > b.data.title ? 1 : -1));

const industries = Array.from(new Set(all.map((cs) => cs.data.industry))).sort();
---

<BaseLayout title={meta.title} description={meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title="Proiectele noastre."
    subtitle="Selecție de proiecte recente cu cifre validate de clienți. Mai multe case studies vin pe măsură ce primim acordul de publicare."
  />

  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-16">
      {industries.length > 1 && (
        <div class="flex flex-wrap items-center gap-3" role="group" aria-label="Filtru industrie">
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// FILTRU</span>
          <button
            type="button"
            data-filter="all"
            class="border border-gpc-green bg-gpc-green/10 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-green"
            aria-pressed="true"
          >
            Toate
          </button>
          {industries.map((ind) => (
            <button
              type="button"
              data-filter={ind}
              class="border border-gpc-border bg-gpc-card/30 px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green"
              aria-pressed="false"
            >
              {ind}
            </button>
          ))}
        </div>
      )}

      {all.length === 0 ? (
        <p class="py-12 text-center font-mono text-gpc-ink/60">Studii de caz în curând.</p>
      ) : (
        <div id="cs-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {all.map((cs) => {
            const d = cs.data;
            const heroMetric = d.heroMetric ?? (d.results[0] ? { value: d.results[0].value, label: d.results[0].metric } : undefined);
            const kpis = d.results.map((r) => ({ label: r.metric, value: r.value }));
            const meta = d.location ?? d.duration ?? d.industry;
            const summary = d.anonymized ? `${d.industry} · ${meta}` : `${d.client} · ${meta}`;
            return (
              <div data-industry={d.industry}>
                <CaseStudyCard
                  title={d.title}
                  industry={d.industry}
                  image={d.images?.hero ?? d.heroImage}
                  summary={summary}
                  link={localizedPath(locale, `/portofoliu/${cs.slug}`)}
                  heroMetric={heroMetric}
                  kpis={kpis}
                />
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <CTA
    heading="Vrei să fii următorul studiu de caz?"
    subtext="Programează un audit gratuit și aflăm dacă putem aduce rezultate similare în industria ta."
    buttonText="Programează audit"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#cs-grid > [data-industry]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter ?? 'all';

      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('border-gpc-green', active);
        b.classList.toggle('bg-gpc-green/10', active);
        b.classList.toggle('text-gpc-green', active);
        b.classList.toggle('border-gpc-border', !active);
        b.classList.toggle('bg-gpc-card/30', !active);
        b.classList.toggle('text-gpc-ink/80', !active);
      });

      cards.forEach((card) => {
        const ind = card.dataset.industry ?? '';
        const show = target === 'all' || ind === target;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
