---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import HowWeWork from '../components/HowWeWork.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { type Locale, localizedPath } from '../utils/i18n';

const locale: Locale = 'ro';

const meta = {
  title: 'Servicii Web — Site-uri & Landing Pages care convertesc | Green Phoenix',
  description:
    'Site-uri și landing pages construite pe Astro, WordPress sau Shopify. Performanță 95+ Lighthouse, SEO tehnic, CRO și tracking GA4 server-side. Audit gratuit.',
};

const sections = [
  {
    number: '01',
    title: 'Landing Pages',
    accentTag: 'CONVERSION',
    description: 'Pagini de conversie construite pentru o singură ofertă, optimizate pe Core Web Vitals și A/B testing.',
    ctaText: 'Vezi detalii landing',
    link: '#landing-detail',
  },
  {
    number: '02',
    title: 'Site-uri complete',
    accentTag: 'CORPORATE',
    description: 'Site-uri de prezentare, blog și portofoliu pe Astro / Next sau WordPress headless, cu structură SEO-friendly.',
    ctaText: 'Vezi detalii site',
    link: '#site-detail',
  },
  {
    number: '03',
    title: 'Optimizare CRO',
    accentTag: 'CRO',
    description: 'A/B testing pe pagini existente, heatmaps, session replay, ipoteze și iterații săptămânale pe funnel.',
    ctaText: 'Vezi detalii CRO',
    link: '#cro-detail',
  },
  {
    number: '04',
    title: 'Tracking & Analytics',
    accentTag: 'DATA',
    description: 'GA4, GTM, conversii server-side, Looker Studio dashboards și Consent Mode v2 implementate corect.',
    ctaText: 'Vezi detalii tracking',
    link: '#tracking-detail',
  },
];

const stack = [
  'Astro',
  'Next.js',
  'WordPress',
  'Shopify',
  'Tailwind CSS',
  'Sanity / Storyblok',
  'Vercel / Netlify',
  'Cloudflare',
];

const pricing = [
  {
    tag: 'LANDING',
    title: 'O pagină, o ofertă',
    price: 'de la 1.200 EUR',
    bullets: ['Design + dev', 'Mobile-first', 'GA4 + tag manager', 'Livrare în 2 săptămâni'],
  },
  {
    tag: 'SITE',
    title: 'Prezentare 5-10 pagini',
    price: 'de la 3.500 EUR',
    bullets: ['Design + dev', 'CMS pentru editare', 'SEO tehnic', 'Tracking complet'],
  },
  {
    tag: 'E-COMMERCE',
    title: 'Shop Shopify / Woo',
    price: 'de la 5.500 EUR',
    bullets: ['Theme custom', 'Integrare plată', 'Email + retargeting', 'Server-side tracking'],
  },
];

const faqItems = [
  {
    question: 'Cât durează construcția unui site?',
    answer:
      'Landing page: 2 săptămâni. Site de prezentare 5-10 pagini: 4-6 săptămâni. E-commerce: 6-10 săptămâni. Variabilele majore sunt timpul de aprobare al copy-ului și disponibilitatea fotografiilor / video-urilor.',
  },
  {
    question: 'Pe ce platformă recomandați să construim?',
    answer:
      'Depinde de scop. Pentru viteză + SEO + landing: Astro sau Next. Pentru blog editat de echipă non-tehnică: WordPress headless. Pentru e-commerce DTC: Shopify. Recomandarea vine după audit-ul de obiective, nu invers.',
  },
  {
    question: 'Site-ul include și SEO?',
    answer:
      'SEO tehnic e inclus by default: schema, sitemap, canonical, robots, Core Web Vitals, structură URL. SEO de conținut (articole, optimizare on-page) e proiect separat și-l ofertăm distinct.',
  },
  {
    question: 'Ce înseamnă optimizare CRO?',
    answer:
      'Conversion Rate Optimization înseamnă creșterea procentului de vizitatori care fac acțiunea dorită (cumpără, completează un formular). Lucrăm cu heatmaps, session replay (Hotjar / Microsoft Clarity), ipoteze documentate și A/B testing.',
  },
  {
    question: 'Asigurați și mentenanță după lansare?',
    answer:
      'Da. Pachet de mentenanță separat: update-uri, securitate, backup-uri, monitorizare uptime, mici intervenții lunare. De la 200 EUR / lună.',
  },
];
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} faqSchema={faqItems}>
  <Hero
    locale={locale}
    variant="compact"
    title="Site-uri rapide, optimizate să vândă."
    subtitle="Landing pages și site-uri complete construite pentru performanță și conversie. Stack modern, SEO tehnic și tracking corect by default. Audit gratuit pe site-ul existent."
    ctaLabel="Cere audit gratuit web"
    ctaHref={localizedPath(locale, '/contact')}
  />

  <!-- Intro long-form copy -->
  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="sticky top-28 font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// CE FACEM</p>
      </div>
      <div class="space-y-6 font-mono text-base leading-relaxed text-gpc-ink/85 lg:col-span-8">
        <h2 class="font-display text-3xl text-gpc-ink md:text-4xl">
          Site-uri pentru <span class="glow-green">business</span>, nu pentru ego.
        </h2>
        <p>
          Construim site-uri care fac un singur lucru bine: aduc rezultate de business. Nu animații pentru showreel, nu efecte parallax care încarcă 8 secunde, nu hero-video-uri de 50MB. Performanță, claritate, conversie.
        </p>
        <p>
          Stack-ul depinde de scop. Pentru landing pages și site-uri marketing alegem Astro — generează HTML static, zero JS by default, scor 95+ Lighthouse fără efort. Pentru blog și conținut editat de echipă, recomandăm WordPress headless sau un CMS (Sanity, Storyblok). Pentru e-commerce DTC, Shopify e default-ul.
        </p>
        <p>
          Indiferent de stack, fundamentele sunt aceleași: structură semantică, SEO tehnic curat, tracking server-side din ziua 1, Core Web Vitals în zona verde, mobile-first design și un design system reutilizabil. Tot ce livrăm vine cu documentație și acces complet — niciodată dependency lock-in.
        </p>
        <p>
          Procesul e clar: 1) audit & strategie (1 săptămână), 2) wireframes & UX (1-2 săptămâni), 3) design vizual (1-2 săptămâni), 4) dev & integrare (2-6 săptămâni), 5) QA + lansare (1 săptămână), 6) optimizare post-lansare. Fiecare etapă are un rezultat tangibil pe care-l aprobi înainte să trecem mai departe.
        </p>
        <p>
          După lansare, ne ocupăm de tracking, dashboard-uri și CRO continuu. Un site nu e un proiect "build & forget" — e un asset care trebuie întreținut, măsurat și optimizat.
        </p>
      </div>
    </div>
  </section>

  <!-- Service modules -->
  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// MODULE</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">
        Patru direcții, un proces unitar
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {sections.map((s) => (
          <ServiceCard
            number={s.number}
            title={s.title}
            description={s.description}
            link={localizedPath(locale, '/contact')}
            ctaText={s.ctaText}
            accentTag={s.accentTag}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Detail blocks -->
  <section id="landing-detail" class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">LANDING PAGES</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">O ofertă, o pagină, o decizie</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          Landing pages-urile noastre nu sunt versiuni mici de site-uri. Sunt construite în jurul unei singure oferte și a unui singur CTA. Tot copy-ul, fiecare imagine, fiecare modul există ca să ducă vizitatorul mai aproape de conversie.
        </p>
        <p>
          Stack default: Astro pentru HTML static + zero JavaScript pe pagini publice, Tailwind pentru design system, formular conectat la HubSpot / Mailchimp / Webhook custom, GA4 cu evenimente customizate.
        </p>
        <p>
          Lucrăm cu copy-writeri când e nevoie, dar copy-ul de bază îl facem in-house pentru că e legat strict de strategia de funnel — nu ceva de delegat fără context.
        </p>
      </div>
    </div>
  </section>

  <section id="site-detail" class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">SITE-URI COMPLETE</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Site-uri marketing & corporate</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          Pentru site-uri de prezentare 5-15 pagini, alegem un stack care echilibrează viteza cu ușurința de editare: Astro + Sanity headless, WordPress cu temă custom optimizată, sau Next + Storyblok pentru cazuri mai complexe.
        </p>
        <p>
          Fiecare site include: structură SEO-friendly cu schema markup, sitemap automat, OG tags dinamice, robots.txt corect, redirects 301 din site-ul vechi, dashboard de tracking în Looker Studio.
        </p>
        <p>
          Pentru content multilingv (RO/EN/IT), folosim un CMS cu suport nativ și un sistem de hreflang automat. Nu plugin-uri prost configurate care strică SEO-ul.
        </p>
      </div>
    </div>
  </section>

  <section id="cro-detail" class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">CRO</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">Conversion Rate Optimization</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          Pe site-uri existente cu trafic, primul efort eficient nu e mai mult buget — e CRO. O creștere de 1% la rata de conversie se traduce direct în 10-30% mai mulți clienți, fără un euro în plus pe ads.
        </p>
        <p>
          Procesul: instalare heatmaps + session replay (Hotjar sau Microsoft Clarity gratuit), audit de friction points, prioritizare ipoteze (după impact estimat și efort), A/B testing cu Convert sau VWO, raportare săptămânală pe statistic significance, nu pe vibe.
        </p>
      </div>
    </div>
  </section>

  <section id="tracking-detail" class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <span class="inline-block border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">TRACKING</span>
        <h3 class="mt-4 font-display text-2xl text-gpc-ink md:text-3xl">GA4, GTM, conversii server-side</h3>
      </div>
      <div class="space-y-4 font-mono text-sm leading-relaxed text-gpc-ink/80 lg:col-span-8">
        <p>
          Tracking-ul corect e fundația întregii decizii de marketing. Implementăm GA4 cu evenimente customizate (nu doar pageview), GTM cu data layer curat, Consent Mode v2 GDPR-compliant, conversii server-side pe Meta CAPI și Google Enhanced Conversions.
        </p>
        <p>
          Pentru e-commerce, integrăm Enhanced Ecommerce complet cu funnel-ul real (view item → add to cart → begin checkout → purchase) și atribuim canalele cu modelul data-driven.
        </p>
        <p>
          Livrăm toate dashboard-urile în Looker Studio, cu acces share-able pentru echipa ta și schemă clară de KPI.
        </p>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="border-t border-gpc-border bg-gpc-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// STACK</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">
        Tehnologii cu care lucrăm zilnic
      </h2>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {stack.map((s) => (
          <li class="border border-gpc-border bg-gpc-card/30 px-4 py-3 font-mono text-sm uppercase tracking-wider text-gpc-ink/80 transition-colors hover:border-gpc-green hover:text-gpc-green">
            <span class="mr-2 text-gpc-green">›</span>{s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pricing -->
  <section class="border-t border-gpc-border bg-gpc-card/10">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gpc-green">// PREȚURI</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl text-gpc-ink md:text-4xl">
        Pachete de bază
      </h2>
      <p class="mt-4 max-w-2xl font-mono text-sm leading-relaxed text-gpc-ink/70">
        Prețurile de mai jos sunt punct de plecare. Oferta finală depinde de numărul de pagini, integrări (CRM, plată, ERP) și volumul de conținut.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {pricing.map((p, i) => (
          <article class:list={[
            'flex flex-col border bg-gpc-card/30 p-6',
            i === 1 ? 'border-gpc-green shadow-sm' : 'border-gpc-border',
          ]}>
            <span class="inline-block self-start border border-gpc-green/40 bg-gpc-green/5 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-gpc-green">
              {p.tag}
            </span>
            <h3 class="mt-5 font-display text-xl text-gpc-ink">{p.title}</h3>
            <p class="mt-3 font-display text-2xl glow-green">{p.price}</p>
            <ul class="mt-6 flex-1 space-y-2 font-mono text-sm text-gpc-ink/80">
              {p.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-gpc-green">✓</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <a
              href={localizedPath(locale, '/contact')}
              class="mt-8 inline-flex items-center justify-center border border-gpc-green px-4 py-3 font-mono text-xs uppercase tracking-widest text-gpc-green transition-colors hover:bg-gpc-green hover:text-gpc-ink"
            >
              Cere ofertă
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork locale={locale} />

  <FAQ items={faqItems} title="ÎNTREBĂRI FRECVENTE — WEB" schema={false} />

  <CTA
    heading="Vrei un audit gratuit pe site-ul tău?"
    subtext="Verificăm Core Web Vitals, SEO tehnic, tracking, UX și friction points. Pleci cu un raport concret și 3-5 acțiuni prioritare."
    buttonText="Programează audit gratuit"
    buttonLink={localizedPath(locale, '/contact')}
  />
</BaseLayout>
