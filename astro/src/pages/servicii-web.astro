---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import { getPageCopy } from '../utils/content';
import { localizedPath } from '../utils/i18n';

const locale = 'ro' as const;
const c = getPageCopy(locale, 'servicii-web');

const services = [
  { number: '01', title: 'Site-uri de prezentare', description: 'Astro/Next + CMS, performanță 100/100 Lighthouse.', accentTag: 'CORPORATE', ctaText: 'Vezi pachet' },
  { number: '02', title: 'Landing pages', description: 'Pagini de conversie pentru campanii ads.', accentTag: 'CONVERSION', ctaText: 'Vezi pachet' },
  { number: '03', title: 'E-commerce', description: 'Shopify și WooCommerce optimizate.', accentTag: 'SHOP', ctaText: 'Vezi pachet' },
  { number: '04', title: 'SEO Tehnic', description: 'Core Web Vitals, schema, sitemap, indexare.', accentTag: 'SEO', ctaText: 'Vezi pachet' },
  { number: '05', title: 'CRO', description: 'A/B testing, heatmaps, optimizare funnel.', accentTag: 'CRO', ctaText: 'Vezi pachet' },
  { number: '06', title: 'Mentenanță', description: 'Update-uri, securitate și backup-uri continue.', accentTag: 'OPS', ctaText: 'Vezi pachet' },
];
---

<BaseLayout title={c.meta.title} description={c.meta.description} locale={locale}>
  <Hero
    locale={locale}
    variant="compact"
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    ctaLabel={c.hero.ctaLabel}
    ctaHref={localizedPath(locale, '/contact')}
  />
  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          number={s.number}
          title={s.title}
          description={s.description}
          link={localizedPath(locale, '/contact')}
          ctaText={s.ctaText}
          accentTag={s.accentTag}
        />
      ))}
    </div>
  </section>
  <CTA
    title="Pregătit pentru un site nou?"
    description="Discutăm despre obiective și livrăm un proiect personalizat."
    ctaLabel="Solicită proiect"
    ctaHref={localizedPath(locale, '/contact')}
  />
</BaseLayout>
